---
import type { ExploreGroup } from "../lib/catalog.ts";
import { t } from "../lib/i18n.ts";

/**
 * "Explorar" strip (docs/design/paginas-catalogo.md, "Franja Explorar"), shared by the catalog pages
 * and the home page (PRD-004, RF-3). It is a white band of its own: the caller must not wrap it.
 * `groups` comes from `exploreGroups` (plus "Rankings" as the last group on /coches), so it only links
 * pages that exist (CA-12a). Every group, "Rankings" included, gets exactly the same style.
 * `showAll` adds "Todos los coches": every page but /coches itself.
 */
interface Props {
  groups: ExploreGroup[];
  showAll: boolean;
}
const { groups, showAll } = Astro.props;

const linkClass = "inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800 [overflow-wrap:anywhere]";
---

<nav class="band-white" aria-labelledby="explorar" data-explore>
  <div class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8">
    <h2
      id="explorar"
      class="mb-4 text-block font-bold [font-stretch:var(--font-stretch-wide)] [overflow-wrap:anywhere]"
    >{t("explorar.titulo")}</h2>
    {
      groups.map((group) => (
        <div class="border-t border-line-soft py-3 md:grid md:grid-cols-[var(--width-explore-label)_minmax(0,1fr)] md:items-baseline md:gap-x-6 md:py-1">
          <h3 class="text-small font-bold uppercase tracking-[0.04em] md:pt-3">{group.label}</h3>
          <ul class="flex flex-wrap gap-x-5">
            {group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  aria-current={link.current ? "page" : undefined}
                  class:list={[
                    linkClass,
                    "aria-[current=page]:font-semibold aria-[current=page]:text-ink-900 aria-[current=page]:no-underline",
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    {
      showAll && (
        <div class="border-t border-line-soft py-1">
          <a href="/coches/" class={linkClass}>
            {t("explorar.todos")}
          </a>
        </div>
      )
    }
  </div>
</nav>
