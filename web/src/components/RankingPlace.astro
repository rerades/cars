---
import { t } from "../lib/i18n.ts";
import type { PlaceView } from "../lib/ranking-view.ts";

/**
 * One place of a ranking (docs/design/rankings.md, "Lista de puestos"). The same markup paints the
 * list of the HTML and the `<template>` the filter script clones and fills with `textContent` and
 * attributes (never `innerHTML` with data). `place` is null for the template: every optional part
 * (tie, deal badge, note, terms link, unofficial mark) is then present and the script removes what
 * the entry does not have.
 */
interface Props {
  place: PlaceView | null;
}
const { place: p } = Astro.props;
// "Fuente: {fuente}, {fecha}": the source name is the link, so split the message around a marker.
// Name and date get their own slots so the script sets them with `textContent`.
const [before = "", between = "", after = ""] = t("ranking.fuente", { fuente: "\u0001", fecha: "\u0002" }).split(
  /[\u0001\u0002]/,
);
const tpl = p === null;
---

<li
  value={p?.place}
  class="grid grid-cols-[var(--width-rank-number)_minmax(0,1fr)] gap-x-3 border-b border-line-soft py-4 [overflow-wrap:anywhere]"
  data-place={p?.place}
>
  <h3 class="col-span-2 grid grid-cols-subgrid items-start text-card-title text-ink-900">
    <span class="flex flex-col text-rank-number text-ink-900" data-place-number>
      <span class="sr-only">{t("ranking.puesto.sr")} </span>
      <span data-place-value>{p?.place}</span>
      {
        (tpl || p.tied) && (
          <span class="text-small font-normal text-ink-600" data-tie>
            {t("ranking.puesto.empate")}
          </span>
        )
      }
    </span>
    <a href={p?.href} class="text-brand-600 underline hover:text-brand-800" data-place-link>
      {p ? `${p.brand} ${p.model}` : ""}
    </a>
  </h3>
  <p class="col-start-2 text-body text-ink-900" data-version>
    {p?.version}
  </p>
  <p class="col-start-2 text-small text-ink-600" data-segment>
    <span class="sr-only">{t("ranking.segmento.sr")} </span><span data-segment-text>{p?.segment}</span>
  </p>
  <p class="col-start-2 mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-price text-ink-900" data-figure>
    <span data-figure-value>{p?.figure}</span>
    {
      (tpl || p.deal) && (
        <span class="inline-block rounded-full bg-deal-bg px-3 py-1 text-badge text-deal-fg" data-deal-badge>
          {t("ficha.precio.oferta")}
        </span>
      )
    }
  </p>
  <p class="col-start-2 text-small text-ink-600" data-source>
    {before}<a
      href={p?.source.url}
      rel="noopener"
      class="text-brand-600 underline hover:text-brand-800"
      data-source-link>{p?.source.name}</a
    >{between}<span data-source-date>{p?.source.date}</span>{after}{
      (tpl || p.source.unofficial) && (
        <> <span data-unofficial>{t("ranking.noOficial")}</span></>
      )
    }
  </p>
  {
    (tpl || p.note) && (
      <p class="col-start-2 text-small text-ink-600" data-note>
        {p?.note}
      </p>
    )
  }
  {
    (tpl || p.deal) && (
      <a
        href={p?.deal ? `#${p.deal.id}` : undefined}
        class="col-start-2 inline-flex min-h-touch items-center text-small text-brand-600 underline hover:text-brand-800"
        data-terms-ref>{t("ficha.precio.verCondiciones")}</a
      >
    )
  }
</li>
