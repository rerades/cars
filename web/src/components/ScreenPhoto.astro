---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A photo with the common treatment of propuesta-a.md: desaturated, dimmed, a cold tone and a vignette,
 * plus the scrim the parent defines. Shared by the catalog card (ModelCard) and the model page's first screen.
 * The parent positions it (it fills its box) and sets `--scrim-rgb` and `--scrim`; the alt text arrives by props.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  width?: number;
  height?: number;
}
const { src, alt, widths, sizes, loading = "lazy", fetchpriority, width, height } = Astro.props;
---

<div class="screen-photo">
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} width={width} height={height} />
</div>

<style is:global>
  .screen-photo {
    inset: 0;
    overflow: hidden;
    position: absolute;
  }
  .screen-photo img {
    display: block;
    filter: saturate(0.72) contrast(1.06) brightness(0.86);
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .screen-photo::before,
  .screen-photo::after {
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }
  .screen-photo::before {
    background: #1d4a5c;
    mix-blend-mode: color;
    opacity: 0.32;
  }
  .screen-photo::after {
    background:
      radial-gradient(ellipse 72% 78% at 50% 52%, transparent 45%, rgb(var(--scrim-rgb) / 0.62) 100%),
      var(--scrim);
  }
</style>
