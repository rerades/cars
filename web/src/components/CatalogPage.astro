---
import "../styles/global.css";
import ModelCard from "./ModelCard.astro";
import CatalogFilters from "./CatalogFilters.astro";
import type { CardView } from "../lib/card.ts";
import type { ExploreGroup } from "../lib/catalog.ts";
import type { FilterPanelView } from "../lib/filter-view.ts";
import { t } from "../lib/i18n.ts";

/**
 * Pregenerated catalog page (docs/design/paginas-catalogo.md, "Estructura común"): skip link, h1,
 * intro, counter and results list (or the empty state). Reused by /coches, /marcas/{marca} and the
 * other pregenerated pages (#39). Every text arrives composed in props (RNF-4). The "Explorar"
 * strip only links pages that exist (CA-12a): `explore` comes from `exploreGroups`.
 *
 * With `filters` (only /coches) the page gets the browser-side filter panel as a progressive
 * enhancement: the HTML still carries every card (RNF-1) and the panel stays hidden without JS.
 */
interface Props {
  title: string;
  intro: string;
  count: string;
  cards: CardView[];
  /** Text of the empty state; the page shows it instead of the list when there are no cards. */
  emptyText: string;
  /** Groups of the "Explorar" strip, already composed by `exploreGroups` (links to existing pages only). */
  explore: ExploreGroup[];
  /** URL of this page, to hide "Todos los coches" on /coches itself. */
  currentHref: string;
  /** Show the way out to /coches in the empty state (tramo pages, paginas-catalogo.md "Estado vacío"). */
  emptyLink?: boolean;
  filters?: {
    view: FilterPanelView;
    /** Data attributes of each card, same order as `cards` (filter.ts, factAttrs). */
    facts: Record<string, string>[];
  };
}
const { title, intro, count, cards, emptyText, explore, currentHref, emptyLink = false, filters } = Astro.props;

// Absolute canonical URL of the page itself, as served (trailing slash), never with a query string (CA-13).
const canonical = new URL(currentHref, Astro.site).href;

const site = t("sitio.nombre");
const documentTitle = site ? t("pagina.tituloDocumento", { titulo: title, sitio: site }) : title;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a
      href="#resultados"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:bg-surface focus:p-2 focus:text-brand-600 focus:underline"
      >{t("pagina.saltar")}</a
    >
    <main class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8">
      <h1 class="text-title [overflow-wrap:anywhere]">{title}</h1>
      <p class="mt-2 max-w-prose text-body text-ink-900" data-intro>{intro}</p>
      <p
        class="mt-3 text-body text-ink-600"
        data-count
        role={filters ? "status" : undefined}
        aria-live={filters ? "polite" : undefined}
      >{count}</p>
      {filters && <p class="mt-2 max-w-prose text-body text-ink-600" data-no-js>{t("filtros.sinJs")}</p>}

      <nav class="mt-8" aria-labelledby="explorar" data-explore>
        <h2 id="explorar" class="text-section">{t("explorar.titulo")}</h2>
        {
          explore.map((group) => (
            <div class="mt-4 md:mt-2 md:flex md:items-baseline">
              <h3 class="text-group md:w-explore-label md:shrink-0">{group.label}</h3>
              <ul class="flex flex-wrap gap-x-2 gap-y-1">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.current ? "page" : undefined}
                      class:list={[
                        "inline-flex min-h-touch items-center text-body",
                        link.current
                          ? "font-semibold text-ink-900 no-underline"
                          : "text-brand-600 underline hover:text-brand-800",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        {
          currentHref !== "/coches/" && (
            <p class="mt-4 md:mt-2">
              <a
                href="/coches/"
                class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
              >
                {t("explorar.todos")}
              </a>
            </p>
          )
        }
      </nav>

      <div class:list={["mt-8", filters && "lg:grid lg:grid-cols-[18rem_1fr] lg:gap-8"]}>
        {filters && <CatalogFilters view={filters.view} />}
        <section aria-labelledby="resultados" class="mt-8 lg:mt-0">
          <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
            <h2 id="resultados" tabindex="-1" class="text-section">{t("resultados.titulo")}</h2>
            {
              filters && (
                <div data-sort-row hidden class="flex flex-col gap-1 lg:flex-row lg:items-center lg:gap-2">
                  <label for="orden" class="text-body">{filters.view.labels.sort}</label>
                  <select
                    id="orden"
                    name="orden"
                    data-sort
                    class="min-h-11 w-full rounded-card border border-line bg-surface px-3 text-body text-ink-900 lg:w-auto"
                  >
                    {filters.view.sorts.map((o) => <option value={o.value}>{o.label}</option>)}
                  </select>
                </div>
              )
            }
          </div>
          {filters && <div data-chips hidden class="mt-2 flex flex-wrap gap-2" role="group" aria-label={filters.view.labels.active}></div>}
          {
            cards.length > 0 ? (
              <ul
                data-results
                aria-labelledby="resultados"
                class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3"
              >
                {cards.map((card, i) => (
                  <ModelCard card={card} href={`/marcas/${card.key}/`} facts={filters?.facts[i]} eager={i < 3} />
                ))}
              </ul>
            ) : (
              <div class="mt-4">
                <p class="text-body text-ink-900">{emptyText}</p>
                {emptyLink && (
                  <a
                    href="/coches/"
                    class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
                  >
                    {t("vacio.pagina.enlace")}
                  </a>
                )}
              </div>
            )
          }
          {
            filters && cards.length > 0 && (
              <div data-empty hidden role="status" class="mt-4 flex flex-col items-start gap-2">
                <h2 class="text-section">{filters.view.labels.emptyTitle}</h2>
                <p class="text-body text-ink-900">{filters.view.labels.emptyText}</p>
                <button
                  type="button"
                  data-empty-clear
                  class="min-h-11 rounded-card bg-brand-600 px-4 text-body text-on-brand hover:bg-brand-800"
                >{filters.view.labels.clear}</button>
              </div>
            )
          }
        </section>
      </div>
    </main>
  </body>
</html>
