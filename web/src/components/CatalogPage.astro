---
import "../styles/global.css";
import ModelCard from "./ModelCard.astro";
import type { CardView } from "../lib/card.ts";
import type { ExploreGroup } from "../lib/catalog.ts";
import { t } from "../lib/i18n.ts";

/**
 * Pregenerated catalog page (docs/design/paginas-catalogo.md, "Estructura común"): skip link, h1,
 * intro, counter and results list (or the empty state). Reused by /coches, /marcas/{marca} and the
 * other pregenerated pages (#39). Every text arrives composed in props (RNF-4). The "Explorar"
 * strip only links pages that exist (CA-12a): `explore` comes from `exploreGroups`.
 */
interface Props {
  title: string;
  intro: string;
  count: string;
  cards: CardView[];
  /** Text of the empty state; the page shows it instead of the list when there are no cards. */
  emptyText: string;
  /** Groups of the "Explorar" strip, already composed by `exploreGroups` (links to existing pages only). */
  explore: ExploreGroup[];
  /** URL of this page, to hide "Todos los coches" on /coches itself. */
  currentHref: string;
  /** Show the way out to /coches in the empty state (tramo pages, paginas-catalogo.md "Estado vacío"). */
  emptyLink?: boolean;
}
const { title, intro, count, cards, emptyText, explore, currentHref, emptyLink = false } = Astro.props;

const site = t("sitio.nombre");
const documentTitle = site ? t("pagina.tituloDocumento", { titulo: title, sitio: site }) : title;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a
      href="#resultados"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:bg-surface focus:p-2 focus:text-brand-600 focus:underline"
      >{t("pagina.saltar")}</a
    >
    <main class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8">
      <h1 class="text-title [overflow-wrap:anywhere]">{title}</h1>
      <p class="mt-2 max-w-prose text-body text-ink-900" data-intro>{intro}</p>
      <p class="mt-3 text-body text-ink-600" data-count>{count}</p>

      <nav class="mt-8" aria-labelledby="explorar" data-explore>
        <h2 id="explorar" class="text-section">{t("explorar.titulo")}</h2>
        {
          explore.map((group) => (
            <div class="mt-4 md:mt-2 md:flex md:items-baseline">
              <h3 class="text-group md:w-explore-label md:shrink-0">{group.label}</h3>
              <ul class="flex flex-wrap gap-x-2 gap-y-1">
                {group.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={link.current ? "page" : undefined}
                      class:list={[
                        "inline-flex min-h-touch items-center text-body",
                        link.current
                          ? "font-semibold text-ink-900 no-underline"
                          : "text-brand-600 underline hover:text-brand-800",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        {
          currentHref !== "/coches/" && (
            <p class="mt-4 md:mt-2">
              <a
                href="/coches/"
                class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
              >
                {t("explorar.todos")}
              </a>
            </p>
          )
        }
      </nav>

      <section class="mt-8" aria-labelledby="resultados">
        <h2 id="resultados" tabindex="-1" class="text-section">{t("resultados.titulo")}</h2>
        {
          cards.length > 0 ? (
            <ul
              aria-labelledby="resultados"
              class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3"
            >
              {cards.map((card) => (
                <ModelCard card={card} href={`/marcas/${card.key}/`} />
              ))}
            </ul>
          ) : (
            <div class="mt-4">
              <p class="text-body text-ink-900">{emptyText}</p>
              {emptyLink && (
                <a
                  href="/coches/"
                  class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
                >
                  {t("vacio.pagina.enlace")}
                </a>
              )}
            </div>
          )
        }
      </section>
    </main>
  </body>
</html>
