---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CardView } from "../lib/card.ts";
import { imageRelPath } from "../lib/data.ts";
import Cifra from "./Cifra.astro";
import SegmentSilhouette from "./SegmentSilhouette.astro";

/**
 * Model card as a screen (docs/design/tarjeta-modelo.md, "Dirección visual: la tarjeta es una pantalla").
 * Static HTML, no JS. Every string arrives in `card`; the component only lays it out.
 * - With a photo (RF-8, ADR-0012): a dark band; the photo, with the common treatment of propuesta-a.md, melts
 *   into it through a scrim and the text sits on the solid part. Without one: a light band with the segment
 *   silhouette drawn large and thin behind the text (CA-17).
 * - The wide layout (photo on 70 %, sides alternating) follows the card's own width: the `li` is a size
 *   container, so the card works in a grid and as a full-width screen in a one-column list.
 * - The model name is the screen's link, stretched over it with a pseudo-element; "Comparar" and the photo
 *   credit sit above it as their own links.
 */
interface Props {
  card: CardView;
  href: string;
  /** Data attributes the /coches filters read (filter.ts, factAttrs); absent on pages without filters. */
  facts?: Record<string, string>;
  /** No lazy loading: only the first screen (LCP). */
  eager?: boolean;
}
const { card, href, facts, eager = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("@images/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}", { eager: true });
const rel = card.image ? imageRelPath(card.image.file) : null;
const src = rel
  ? Object.entries(files).find(([key]) => key.endsWith(`/${rel}`))?.[1].default
  : undefined;
const priceLabel = card.dealLabel ? `${card.labels.price} · ${card.dealLabel}` : card.labels.price;
---

<li
  data-model={facts ? "" : undefined}
  {...facts}
  class:list={["screen", src ? "band-dark" : "band-light"]}
>
  <div class="screen-box">
    {
      src ? (
        <div class="photo" data-slot="image">
          <Image
            src={src}
            alt=""
            widths={[640, 960, 1280]}
            sizes="(min-width: 1024px) 70vw, 100vw"
            loading={eager ? "eager" : "lazy"}
          />
        </div>
      ) : (
        <div class="silhouette" data-slot="silhouette">
          <SegmentSilhouette segment={card.segment} large />
        </div>
      )
    }
    <div class="screen-text">
      <h3 class="screen-name">
        <a href={href} class="enlace-ficha after:absolute after:inset-0 after:content-['']">
          <span class="screen-brand">{card.brand}</span>
          <span class="screen-model" data-name={card.model}>{card.model.split(" ").map((w) => <><span class="word">{w}</span>{" "}</>)}</span>
        </a>
      </h3>
      <p class:list={["screen-segment", !card.hasSegment && "text-ink-600"]} data-field="segment">
        {card.segmentLabel}
      </p>
      {
        card.statusLabel && (
          <p class="screen-status">
            <span
              class:list={[
                "inline-block rounded-full px-3 py-1 text-badge",
                card.statusKind === "soon" ? "bg-soon-bg text-soon-fg" : "bg-discontinued-bg text-discontinued-fg",
              ]}
              data-status={card.statusKind}>{card.statusLabel}</span
            >
          </p>
        )
      }
      <dl class="screen-figures">
        <Cifra size="l" label={priceLabel} text={card.priceText} figure="price" />
        <Cifra size="l" label={card.labels.range} text={card.rangeText} figure="range" />
      </dl>
      {
        (card.compare || (src && card.image?.attribution)) && (
          <p class="screen-foot">
            {card.compare && (
              <a href={card.compare.href} class="enlace-comparar relative z-10 inline-flex min-h-touch items-center text-small font-bold text-brand-600 underline hover:text-brand-800">{card.compare.label}<span class="sr-only"> {card.compare.srLabel}</span></a>
            )}
            {src && card.image?.attribution && (
              <a href={card.image.pageUrl} class="relative z-10 inline-flex min-h-touch items-center text-small text-ink-600 underline [overflow-wrap:anywhere] hover:text-brand-800">{card.image.attribution}</a>
            )}
          </p>
        )
      }
    </div>
  </div>
</li>

<style>
  /* The li is the size container; the box inside it does the layout, so container queries can style it. */
  .screen {
    container-type: inline-size;
  }
  .screen-box {
    --scrim-rgb: 11 18 23; /* ink-950, the dark band */
    --scrim: linear-gradient(to bottom, transparent 30%, rgb(var(--scrim-rgb) / 0.72) 64%, rgb(var(--scrim-rgb) / 1) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    position: relative;
  }

  /* Focus ring inside the screen (tarjeta-modelo.md): brand-600 on light, on-dark on dark (band-dark remaps it). */
  .screen:has(.enlace-ficha:focus-visible) {
    outline: 3px solid var(--color-brand-600);
    outline-offset: -6px;
  }
  .enlace-ficha:focus-visible {
    outline: none;
  }

  /* The common treatment of propuesta-a.md: desaturated, dimmed, a cold tone and a vignette. */
  .photo {
    background: var(--color-ink-950);
    height: 19rem;
    inset: 0 0 auto;
    overflow: hidden;
    position: absolute;
  }
  .photo :global(img) {
    display: block;
    filter: saturate(0.72) contrast(1.06) brightness(0.86);
    height: 100%;
    object-fit: cover;
    width: 100%;
  }
  .photo::before,
  .photo::after {
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }
  .photo::before {
    background: #1d4a5c;
    mix-blend-mode: color;
    opacity: 0.32;
  }
  .photo::after {
    background:
      radial-gradient(ellipse 72% 78% at 50% 52%, transparent 45%, rgb(var(--scrim-rgb) / 0.62) 100%),
      var(--scrim);
  }

  /* No photo: the segment outline, large and thin, behind the text. Decorative (aria-hidden in the SVG). */
  .silhouette {
    --size-segment-icon-lg: 24rem;
    color: var(--color-ink-950);
    display: flex;
    justify-content: center;
    left: 0;
    position: absolute;
    right: 0;
    top: -6.5rem;
  }
  .silhouette :global(svg) {
    stroke-width: 0.3;
  }

  .screen-text {
    padding: 12.5rem 1.25rem 0.5rem;
    position: relative;
  }

  .screen-name {
    margin: 0;
  }
  .enlace-ficha {
    color: var(--color-ink-900);
    display: block;
  }
  .enlace-ficha:hover .screen-model {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.08em;
  }
  .screen-brand {
    display: block;
    font-size: var(--text-body);
    font-weight: 600;
    line-height: var(--text-body--line-height);
  }
  .screen-model {
    display: block;
    font-size: var(--text-screen);
    font-stretch: var(--font-stretch-wide);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 0.98;
    margin-top: 0.125rem;
  }
  /* Names break between words, never inside one ("E-Tech"); a word too long still fits. */
  .word {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .screen-segment {
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    margin-top: 0.5rem;
  }
  .screen-status {
    margin-top: 0.75rem;
  }

  /* Two figures per row, also at 390 px, with a thin line above each. */
  .screen-figures {
    column-gap: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
  }
  .screen-figures > :global(div) {
    border-top: 1px solid var(--color-line-soft);
    padding-top: 0.875rem;
  }
  /* The figure size goes by the viewport; in a card narrower than the screen (a grid) it follows the card,
     so the unit stays on the number's line. 13 cqi is the 3.25 rem minimum at 390 px. */
  .screen-figures > :global(.cifra--l) {
    --cifra-size: min(var(--text-figure-l), 13cqi);
  }

  .screen-foot {
    column-gap: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  /* Wide screen (the card at least 64 rem wide): the photo fills 70 % and melts into the band; sides alternate. */
  @container (min-width: 64rem) {
    .screen-box {
      --scrim: linear-gradient(to right, rgb(var(--scrim-rgb) / 1) 0%, rgb(var(--scrim-rgb) / 0.72) 22%, transparent 55%);
      min-height: 31.5rem;
    }
    .photo {
      height: 100%;
      inset: 0 0 0 30%;
    }
    .screen-text {
      max-width: 44%;
      padding: 2rem 2.5rem 0.75rem;
    }
    .silhouette {
      --size-segment-icon-lg: 42rem;
      justify-content: flex-end;
      padding-right: 3rem;
      top: -7rem;
    }
    .silhouette :global(svg) {
      stroke-width: 0.22;
    }
    .screen:nth-child(even) .screen-box {
      --scrim: linear-gradient(to left, rgb(var(--scrim-rgb) / 1) 0%, rgb(var(--scrim-rgb) / 0.72) 22%, transparent 55%);
    }
    .screen:nth-child(even) .photo {
      inset: 0 30% 0 0;
    }
    .screen:nth-child(even) .screen-text {
      margin-left: auto;
    }
    .screen:nth-child(even) .silhouette {
      justify-content: flex-start;
      padding-left: 3rem;
      padding-right: 0;
    }
  }
</style>
