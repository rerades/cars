---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import type { CardView } from "../lib/card.ts";
import { imageRelPath } from "../lib/data.ts";
import SegmentSilhouette from "./SegmentSilhouette.astro";

/**
 * Model card (docs/design/tarjeta-modelo.md). Static HTML, no JS.
 * Every string arrives in `card`; the component only lays it out. The model name is the card's
 * link, stretched over the whole card with a pseudo-element. The image (RF-8, ADR-0012) is a local
 * file of data/images/ served as WebP; without one, the segment silhouette fills the same 16:9 slot.
 */
interface Props {
  card: CardView;
  href: string;
  /** Data attributes the /coches filters read (filter.ts, factAttrs); absent on pages without filters. */
  facts?: Record<string, string>;
  /** No lazy loading: first row of cards (ADR-0012, point 7). */
  eager?: boolean;
}
const { card, href, facts, eager = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("@images/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}", { eager: true });
const rel = card.image ? imageRelPath(card.image.file) : null;
const src = rel
  ? Object.entries(files).find(([key]) => key.endsWith(`/${rel}`))?.[1].default
  : undefined;
---

<li
  data-model={facts ? "" : undefined}
  {...facts}
  class="relative flex flex-col gap-2 rounded-card border border-line-soft bg-surface p-4 hover:border-brand-600"
>
  <div
    class="flex aspect-video items-center justify-center overflow-hidden rounded-card bg-surface-muted text-line"
    data-slot={src ? "image" : "silhouette"}
  >
    {
      src ? (
        <Image
          src={src}
          alt=""
          width={640}
          height={360}
          widths={[320, 640, 960]}
          sizes="(min-width: 1024px) 24rem, (min-width: 768px) 50vw, 100vw"
          loading={eager ? "eager" : "lazy"}
          class="h-full w-full object-cover"
        />
      ) : (
        <SegmentSilhouette segment={card.segment} />
      )
    }
  </div>
  {
    src && card.image?.attribution && (
      <p class="text-small text-ink-600 [overflow-wrap:anywhere]">
        <a
          href={card.image.pageUrl}
          class="relative z-10 inline-flex min-h-touch items-center text-brand-600 underline hover:text-brand-800"
        >{card.image.attribution}</a>
      </p>
    )
  }
  <p class="text-small text-ink-600 [overflow-wrap:anywhere]">{card.brand}</p>
  <h3 class="text-card-title [overflow-wrap:anywhere]">
    <a
      href={href}
      class="text-ink-900 hover:underline after:absolute after:inset-0 after:content-['']"
    >{card.model}</a>
  </h3>
  {
    card.statusLabel && (
      <p>
        <span
          class:list={[
            "inline-block rounded-full px-3 py-1 text-badge",
            card.statusKind === "soon"
              ? "bg-soon-bg text-soon-fg"
              : "bg-discontinued-bg text-discontinued-fg",
          ]}
          data-status={card.statusKind}>{card.statusLabel}</span
        >
      </p>
    )
  }
  <dl class="mt-auto flex flex-col gap-2">
    <div class="flex flex-wrap items-center gap-2">
      <dt class="sr-only">{card.labels.price}</dt>
      <dd class:list={["text-price", card.hasPrice ? "text-ink-900" : "text-ink-600"]} data-field="price">
        {card.priceLabel}
      </dd>
      {
        card.dealLabel && (
          <dd class="inline-block rounded-full bg-deal-bg px-3 py-1 text-badge text-deal-fg" data-badge="deal">
            {card.dealLabel}
          </dd>
        )
      }
    </div>
    <div>
      <dt class="sr-only">{card.labels.range}</dt>
      <dd class:list={["text-body", !card.hasRange && "text-ink-600"]} data-field="range">{card.rangeLabel}</dd>
    </div>
    <div>
      <dt class="sr-only">{card.labels.segment}</dt>
      <dd class:list={["text-body", !card.hasSegment && "text-ink-600"]} data-field="segment">
        {card.segmentLabel}
      </dd>
    </div>
  </dl>
</li>
