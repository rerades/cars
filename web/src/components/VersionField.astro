---
import type { VersionField } from "../lib/version-fields.ts";
import { t } from "../lib/i18n.ts";
import SourceDate from "./SourceDate.astro";

/**
 * Value of one technical field of a version (RF-5, RF-6, RF-8, RF-9). Without data: «por confirmar»,
 * no source (there is nothing to cite). No ids: the table and the blocks both render this.
 */
interface Props {
  field: VersionField;
}
const { field } = Astro.props;
---

{
  field.datum === null || field.text === null ? (
    <p class="text-body text-ink-600" data-field-value={field.key} data-missing>
      {t("ficha.porConfirmar")}
    </p>
  ) : (
    <div class="flex flex-col gap-1" data-field-value={field.key}>
      <p class="text-body text-ink-900">{field.text}</p>
      {field.datum.note && <p class="text-small text-ink-600">{field.datum.note}</p>}
      <SourceDate source={field.datum} />
    </div>
  )
}
