---
import { t, type MessageKey } from "../lib/i18n.ts";
import { SEGMENTS } from "../lib/filter.ts";
import type { FilterOption } from "../lib/ranking-view.ts";
import type { RankingDef } from "../lib/rankings.ts";

/**
 * Segment and price filters of a ranking (docs/design/rankings.md, "Filtros"; ADR-0015, details 2-4).
 * Progressive enhancement: the selects are not in the served HTML, they live in a `<template>` the
 * script clones (RNF-1); without JavaScript the visitor sees `ranking.filtros.sinJs`. It is not a
 * form and sends nothing (RF-12). The script asks for `/rankings/datos/<slug>.json` only when a
 * filter is needed, and numbers with the same `rankPlaces()` the build uses. Nothing is stored (RNF-5).
 * Texts arrive through `data-messages` (RNF-4).
 */
interface Props {
  ranking: RankingDef;
  segments: FilterOption[];
  prices: FilterOption[];
}
const { ranking, segments, prices } = Astro.props;
const dataUrl = `/rankings/datos/${ranking.url.split("/").pop()}.json`;
const messages: Record<string, string> = {
  segmentoPendiente: t("tarjeta.segmentoPendiente"),
  empate: t("ranking.puesto.empate"),
  error: t("ranking.filtros.error"),
  // Templates with their `{n}` / `{marca}`... markers left in: the script fills them (RNF-4).
  "resumen.n": t("ranking.resumen.n", { n: "{n}" }),
  "resumen.uno": t("ranking.resumen.uno"),
  "resumen.ninguna": t("ranking.resumen.ninguna"),
  "fuera.n": t("ranking.fuera.n", { n: "{n}", dato: t(`${ranking.textKey}.dato` as MessageKey) }),
  "fuera.uno": t("ranking.fuera.uno", { dato: t(`${ranking.textKey}.dato` as MessageKey) }),
  "fuera.ninguna": t("ranking.fuera.ninguna", { dato: t(`${ranking.textKey}.dato` as MessageKey) }),
  dealTitle: t("comparador.condiciones.entrada", { marca: "{marca}", modelo: "{modelo}", nombre: "{nombre}" }),
};
for (const s of SEGMENTS) messages[`segmento.${s}`] = t(`segmento.${s}` as MessageKey);
const field = "min-h-touch w-full rounded-card border border-line bg-surface px-3 text-body text-ink-900";
---

<div
  role="group"
  aria-labelledby="ranking-filtros-titulo"
  class="mt-6"
  data-ranking-filters
  data-ranking={ranking.id}
  data-url={dataUrl}
  data-messages={JSON.stringify(messages)}
>
  <h2 id="ranking-filtros-titulo" class="sr-only">{t("ranking.filtros.titulo")}</h2>
  <noscript>
    <p class="text-small text-ink-600">{t("ranking.filtros.sinJs")}</p>
  </noscript>
  <template data-filters-template>
    <div class="flex flex-col gap-4 md:flex-row md:items-end">
      {
        segments.length > 0 && (
          <label class="flex flex-col gap-1 text-body md:w-64">
            {t("filtros.segmento")}
            <select name="segmento" class={field} data-filter-segment>
              <option value="">{t("ranking.filtros.todos")}</option>
              {segments.map((o) => <option value={o.value}>{o.label}</option>)}
            </select>
          </label>
        )
      }
      <label class="flex flex-col gap-1 text-body md:w-64">
        {t("filtros.precio")}
        <select name="precio" class={field} data-filter-price>
          <option value="">{t("ranking.filtros.cualquiera")}</option>
          {prices.map((o) => <option value={o.value}>{o.label}</option>)}
        </select>
      </label>
    </div>
  </template>
  <template data-filtered-empty-template>
    <div class="mt-4 max-w-prose" data-filtered-empty>
      <p class="text-body text-ink-900">{t("ranking.vacioFiltros.texto")}</p>
      <button
        type="button"
        class="mt-3 min-h-touch rounded-card bg-brand-600 px-4 text-body text-on-brand hover:bg-brand-800"
        data-filters-clear
      >
        {t("ranking.filtros.quitar")}
      </button>
    </div>
  </template>
</div>

<script>
  import { formatEur, sourceView } from "../lib/format.ts";
  import {
    parseRankingFilters,
    rankingById,
    termsAnchorId,
    rankingSearch,
    type RankingFilters,
    type RankingId,
  } from "../lib/rankings.ts";
  import type { RankingJson, RankingJsonEntry } from "../lib/ranking-data.ts";
  import type { Version } from "../lib/data.ts";
  import { versionFields } from "../lib/version-fields.ts";
  import { termsParagraphs } from "../lib/ranking-view.ts";
  import { filteredState, leftOutKey, type DealEntry } from "../lib/ranking-state.ts";

  const root = document.querySelector<HTMLElement>("[data-ranking-filters]");
  const list = document.querySelector<HTMLElement>("[data-ranking-list]");
  const placeTemplate = document.querySelector<HTMLTemplateElement>("[data-place-template]");
  const controls = root?.querySelector<HTMLTemplateElement>("[data-filters-template]");
  const summary = document.querySelector<HTMLElement>("[data-ranking-summary]");
  const leftOutEl = document.querySelector<HTMLElement>("[data-left-out]");
  if (root && list && placeTemplate && controls && summary && leftOutEl) {
    init(root, list, placeTemplate, controls, summary, leftOutEl);
  }

  /** Fills `{name}` markers; the replacement is a function so `$` in data is never special. */
  const fmt = (text: string, vars: Record<string, string | number>) =>
    text.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k] ?? ""));

  function init(
    root: HTMLElement,
    list: HTMLElement,
    placeTemplate: HTMLTemplateElement,
    controls: HTMLTemplateElement,
    summary: HTMLElement,
    leftOutEl: HTMLElement,
  ) {
    const def = rankingById(root.dataset.ranking as RankingId);
    const msg: Record<string, string> = JSON.parse(root.dataset.messages ?? "{}");
    root.append(controls.content.cloneNode(true));
    // The summary is the only live region of the page; it changes without moving the focus (WCAG 4.1.3).
    summary.setAttribute("role", "status");
    summary.setAttribute("aria-live", "polite");
    const heading = document.getElementById("resultados");
    const termsTemplate = document.querySelector<HTMLTemplateElement>("[data-terms-template]");
    const termsSectionTemplate = document.querySelector<HTMLTemplateElement>("[data-terms-section-template]");
    const emptyTemplate = root.querySelector<HTMLTemplateElement>("[data-filtered-empty-template]")!;
    // What the HTML served (no filters): put back, with no request, when the filters are cleared.
    const originalSummary = summary.textContent ?? "";
    const originalLeftOut = leftOutEl.textContent ?? "";
    const originalTerms = document.querySelector<HTMLElement>("[data-condiciones]");
    const segmentSelect = root.querySelector<HTMLSelectElement>("[data-filter-segment]");
    const priceSelect = root.querySelector<HTMLSelectElement>("[data-filter-price]")!;
    // The list of the HTML (unfiltered): put back when the filters are cleared, with no request.
    const original = [...list.children];

    let json: Promise<RankingJson> | null = null;
    /** One request for the page, asked for only when a filter needs it; a failure allows a new try. */
    const load = () => {
      json ??= fetch(root.dataset.url!)
        .then((r) => {
          if (!r.ok) throw new Error(String(r.status));
          return r.json() as Promise<RankingJson>;
        })
        .catch((e) => {
          json = null;
          throw e;
        });
      return json;
    };

    const read = (): RankingFilters => ({
      segment: segmentSelect?.value || null,
      priceBand: priceSelect.value || null,
    });
    const write = (f: RankingFilters) => {
      if (segmentSelect) segmentSelect.value = f.segment ?? "";
      priceSelect.value = f.priceBand ?? "";
    };
    // A value the select has no option for (e.g. a segment this ranking does not have) is not a filter.
    const clamp = (f: RankingFilters): RankingFilters => {
      write(f);
      return read();
    };

    function figureText(entry: RankingJsonEntry): string {
      if (def.field === "price") return formatEur(entry.figure.value);
      const v = { [def.field]: entry.figure } as unknown as Version;
      return versionFields(v).find((x) => x.key === def.field)?.text ?? String(entry.figure.value);
    }

    function fill(entry: RankingJsonEntry, place: number, tied: boolean, deal: DealEntry | null): HTMLElement {
      const li = (placeTemplate.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
      const $ = (sel: string) => li.querySelector<HTMLElement>(sel)!;
      li.setAttribute("value", String(place));
      li.dataset.place = String(place);
      $("[data-place-value]").textContent = String(place);
      if (!tied) $("[data-tie]").remove();
      const link = $("[data-place-link]") as HTMLAnchorElement;
      link.href = `/marcas/${entry.brand}/${entry.slug}/`;
      link.textContent = `${entry.brand_name} ${entry.model}`;
      $("[data-version]").textContent = entry.name;
      $("[data-segment-text]").textContent = entry.segment ? msg[`segmento.${entry.segment}`]! : msg.segmentoPendiente!;
      $("[data-figure-value]").textContent = figureText(entry);
      if (def.field !== "price" || entry.figure.price_kind !== "financed") $("[data-deal-badge]").remove();
      // The link points to the entry of "Condiciones de las ofertas", rebuilt with the same id (#377).
      const ref = li.querySelector<HTMLAnchorElement>("[data-terms-ref]");
      if (ref && deal) ref.href = `#${deal.id}`;
      else ref?.remove();
      const src = sourceView(entry.figure);
      const a = $("[data-source-link]") as HTMLAnchorElement;
      a.href = entry.figure.url;
      a.textContent = src.name;
      $("[data-source-date]").textContent = src.date;
      if (!src.unofficial) $("[data-unofficial]").remove();
      if (entry.figure.note) $("[data-note]").textContent = entry.figure.note;
      else $("[data-note]").remove();
      return li;
    }

    const clearEmpty = () => document.querySelector("[data-filtered-empty]")?.remove();

    /** "Condiciones de las ofertas" for the places shown: rebuilt, or the HTML block put back (RF-5). */
    function setTerms(deals: DealEntry[] | null) {
      document.querySelector("[data-condiciones]")?.remove();
      if (deals === null) {
        if (originalTerms) leftOutEl.after(originalTerms);
        return;
      }
      if (deals.length === 0 || !termsTemplate || !termsSectionTemplate) return;
      const section = (termsSectionTemplate.content.cloneNode(true) as DocumentFragment)
        .firstElementChild as HTMLElement;
      section.setAttribute("data-condiciones", "");
      const ul = section.querySelector("ul")!;
      for (const d of deals) {
        const li = (termsTemplate.content.cloneNode(true) as DocumentFragment).firstElementChild as HTMLElement;
        li.id = d.id;
        li.querySelector("[data-terms-title]")!.textContent = d.title;
        const text = li.querySelector("[data-terms-text]")!;
        const sample = text.firstElementChild as HTMLElement;
        text.replaceChildren(
          ...termsParagraphs(d.terms).map((para) => {
            const p = sample.cloneNode(false) as HTMLElement;
            p.textContent = para;
            return p;
          }),
        );
        (li.querySelector("[data-terms-link]") as HTMLAnchorElement).href = d.termsUrl;
        ul.append(li);
      }
      leftOutEl.after(section);
    }

    function render(data: RankingJson, f: RankingFilters) {
      // Same function as the build, now with the filters: numbered 1..10 inside the result (RF-8).
      const state = filteredState(data, def, f, (e) =>
        fmt(msg.dealTitle!, { marca: e.brand_name, modelo: e.model, nombre: e.name }),
      );
      const dealById = new Map(state.deals.map((d) => [d.id, d]));
      const { places } = state;
      clearEmpty();
      list.hidden = places.length === 0;
      list.replaceChildren(
        ...places.map((p, i) =>
          fill(
            p.entry,
            p.place,
            places[i - 1]?.place === p.place || places[i + 1]?.place === p.place,
            dealById.get(termsAnchorId(p.entry.brand, p.entry.slug, p.entry.name)) ?? null,
          ),
        ),
      );
      if (places.length === 0) {
        list.after(emptyTemplate.content.cloneNode(true));
        document.querySelector("[data-filters-clear]")?.addEventListener("click", clearFilters);
      }
      summary.textContent = fmt(msg[state.summary.replace("ranking.", "")]!, { n: places.length });
      leftOutEl.textContent = fmt(msg[leftOutKey(state.leftOut).replace("ranking.", "")]!, { n: state.leftOut });
      setTerms(state.deals);
    }

    /** Back to the HTML list: selects, URL and focus (the button that had it disappears, WCAG 2.4.3). */
    function clearFilters() {
      write({ segment: null, priceBand: null });
      shown = read();
      void apply(shown);
      heading?.focus();
    }

    let seq = 0;
    async function apply(previous: RankingFilters) {
      const f = read();
      const mine = ++seq;
      if (f.segment === null && f.priceBand === null) {
        clearEmpty();
        list.hidden = false;
        list.replaceChildren(...original);
        summary.textContent = originalSummary;
        leftOutEl.textContent = originalLeftOut;
        setTerms(null);
      } else {
        try {
          const data = await load();
          if (mine !== seq) return; // a later change won
          render(data, f);
        } catch {
          // The data did not arrive: the list stays as it was and the selects go back to match it.
          // The live region says so (ranking.filtros.error); the focus stays on the select. The next
          // change asks for the JSON again (`load()` forgot the failed promise).
          if (mine === seq) {
            write(previous);
            shown = previous;
            summary.textContent = msg.error!;
          }
          return;
        }
      }
      // Replace, not push: one history entry per page (as /coches).
      history.replaceState(null, "", location.pathname + rankingSearch(f));
    }

    // What the list on screen corresponds to: the HTML list (no filters) until a filter is applied.
    let shown: RankingFilters = { segment: null, priceBand: null };
    const wanted = clamp(parseRankingFilters(location.search));
    for (const s of [segmentSelect, priceSelect]) {
      s?.addEventListener("focus", () => void load().catch(() => {}), { once: true });
      s?.addEventListener("change", () => {
        const previous = shown;
        shown = read();
        void apply(previous);
      });
    }
    if (wanted.segment !== null || wanted.priceBand !== null) {
      shown = wanted;
      void apply({ segment: null, priceBand: null });
    }
  }
</script>
