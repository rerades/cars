---
import { t } from "../lib/i18n.ts";

/**
 * Key figure (docs/design/tokens.md, "Tipografía"; PRD-001 RF-1, RF-12; PRD-002 RF-11, RF-18).
 * The number is narrow (`--font-stretch-narrow`, `tabular-nums`) with its unit smaller and wide next
 * to it, and the label sits small under it. In the DOM the `dt` comes before the `dd` so a screen
 * reader says what the figure is first; the order on screen is reversed with CSS (`.cifra` in global.css).
 *
 * `text` is the formatted value ("446 km", "32.800 €") and goes into the served HTML (PRD-002 CA-22).
 * `null` means «por confirmar»: two narrow lines in the place of the number, as tall as it is, so the
 * row does not change height. Put the source mark or note marker in the `marca` slot (it goes with the
 * label) and any extra line in `detalle`. Render it inside a `<dl>`.
 */
interface Props {
  label: string;
  text: string | null;
  size: "xl" | "l" | "m";
  class?: string;
  /** Data hook for tests and styles (`data-figure="price"`). */
  figure?: string;
}
const { label, text, size, class: extra, figure } = Astro.props;
// The unit is the last word; the space between (normal or no-break) is not part of either.
const parts = text?.split(/[\s ]+/).filter(Boolean) ?? [];
const unit = parts.length > 1 ? parts.pop() : null;
const number = parts.join(" ");
const missing = t("ficha.porConfirmar").split(" ");
---

<div class:list={["cifra", `cifra--${size}`, extra]} data-figure={figure} data-missing={text ? undefined : ""}>
  <dt>{label}<slot name="marca" /></dt>
  <dd>
    {
      text ? (
        <span class="cifra__valor">
          {number}
          {unit && <> <span class="cifra__unidad">{unit}</span></>}
        </span>
      ) : (
        <span class="cifra__falta">
          {missing.map((w) => <span>{w}</span>)}
        </span>
      )
    }
  </dd>
  {Astro.slots.has("detalle") && <dd class="cifra__detalle"><slot name="detalle" /></dd>}
</div>
