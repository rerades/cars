---
import { t } from "../lib/i18n.ts";

/**
 * «Comparación» section of /comparar/ (docs/design/comparador.md; ADR-0014). The served HTML has no
 * table: the markup of the table, columns, cells and conditions lives in <template> and the script
 * below clones it and fills it with `textContent` and attributes, never `innerHTML` (ADR-0014).
 * Data-dependent texts (formats, «por confirmar», labels) come from lib/compare.ts; the fixed ones
 * are written here from i18n (RNF-4).
 */
const cell = "align-top p-2 text-left text-body text-ink-900 [overflow-wrap:anywhere] md:p-3";
const link = "text-brand-600 underline hover:text-brand-800";
const note = "text-small text-ink-600 [overflow-wrap:anywhere]";
---

<section aria-labelledby="cmp-tabla" class="mt-8" data-compare hidden>
  <h2 id="cmp-tabla" class="text-section">{t("comparador.tabla.titulo")}</h2>
  <p class="mt-2 max-w-prose text-small text-ink-600">{t("comparador.tabla.entrada")}</p>
  <div class="mt-4" data-table-host></div>
  <div class="mt-6" data-conditions hidden>
    <h3 class="text-card-title">{t("ficha.condiciones.titulo")}</h3>
    <div class="mt-2 flex flex-col gap-4" data-conditions-list></div>
  </div>
</section>

<section aria-labelledby="cmp-fuentes" class="mt-12" data-sources hidden>
  <h2 id="cmp-fuentes" class="text-section text-ink-900">{t("ficha.fuentes.titulo")}</h2>
  <p class="mt-1 text-small text-ink-600">{t("ficha.fuentes.entrada")}</p>
  <ol class="mt-4 flex flex-col gap-3" data-sources-list></ol>
</section>

<template data-tpl="table">
  <table class="w-full table-fixed border-collapse bg-surface">
    <caption class="sr-only" data-slot="caption"></caption>
    <thead><tr data-slot="head"></tr></thead>
  </table>
</template>

<template data-tpl="chosen">
  <li
    tabindex="-1"
    class="flex flex-col gap-2 border-t border-line-soft py-4 first:border-t-0 md:flex-row md:flex-wrap md:items-center md:gap-4"
  >
    <span class="text-card-title text-ink-900 [overflow-wrap:anywhere]" data-slot="title"></span>
    <div class="flex flex-col gap-1 md:flex-row md:items-center md:gap-2" data-slot="wrap">
      <label class="text-small font-semibold text-ink-900" data-slot="label"></label>
      <select
        class="min-h-touch w-full rounded-card border border-line bg-surface px-3 text-body text-ink-900"
        style="max-width: var(--width-version-col-max)"
        data-slot="select"></select>
    </div>
    <p class="text-body text-ink-900 [overflow-wrap:anywhere]" data-slot="single" hidden></p>
    <button
      type="button"
      class="min-h-touch self-start rounded-card border border-line bg-surface px-4 text-body text-ink-900 hover:border-brand-600 md:ml-auto"
      data-slot="remove"
    ><span data-slot="removeText"></span><span class="sr-only" data-slot="removeSr"></span></button>
  </li>
</template>

<template data-tpl="column">
  <th scope="col" class={`${cell} border-l border-line-soft first:border-l-0`}>
    <a data-slot="link" class={`block min-h-touch ${link} text-card-title`}>
      <span class="block text-small text-ink-600" data-slot="brand"></span>
      <span data-slot="model"></span>
      <span class="sr-only" data-slot="sr"></span>
    </a>
    <span class="block text-body font-semibold text-ink-900" data-slot="name"></span>
    <span
      class="mt-1 inline-block rounded-card bg-soon-bg px-3 py-1 text-badge text-soon-fg"
      data-slot="badge"
      hidden></span>
    <span data-slot="marks"></span>
  </th>
</template>

<template data-tpl="mark">
  <span data-mark>
    <a
      class="inline-block min-h-6 min-w-6 text-center text-small text-brand-600 underline hover:text-brand-800"
      data-slot="markLink"><span aria-hidden="true" data-slot="markText"></span></a
    ><span class={note} data-slot="markUnofficial" hidden></span>
  </span>
</template>

<template data-tpl="source">
  <li tabindex="-1" class="text-small text-ink-900 [overflow-wrap:anywhere]">
    <span data-slot="line"></span><br />
    <a rel="noopener" class={link} data-slot="link"></a>
  </li>
</template>

<template data-tpl="field">
  <tbody class="border-t border-line-soft">
    <tr><th class="bg-surface-muted p-2 text-left text-small font-semibold text-ink-900 md:p-3" data-slot="label"></th></tr>
    <tr data-slot="values"></tr>
  </tbody>
</template>

<template data-tpl="cell">
  <td class={`${cell} border-l border-line-soft first:border-l-0`}>
    <p data-slot="text"></p>
    <p class="mt-1" data-slot="dealRow" hidden>
      <span class="inline-block rounded-card bg-deal-bg px-3 py-1 text-badge text-deal-fg" data-slot="deal"></span>
    </p>
    <p class={note} data-slot="source" hidden>
      <span data-slot="before"></span><a class={link} rel="noopener" data-slot="sourceLink"></a><span data-slot="after"></span>
      <span data-slot="unofficial" hidden></span>
    </p>
    <p class={note} data-slot="note" hidden></p>
    <a
      class={`inline-flex min-h-touch items-center text-small ${link}`}
      data-slot="terms"
      hidden>{t("ficha.precio.verCondiciones")}</a
    >
  </td>
</template>

<template data-tpl="condition">
  <div tabindex="-1">
    <p class="text-body font-semibold text-ink-900 [overflow-wrap:anywhere]" data-slot="title"></p>
    <p class="text-body text-ink-900 [overflow-wrap:anywhere]" data-slot="text" hidden></p>
    <a
      class={`inline-flex min-h-touch items-center text-body ${link}`}
      rel="noopener"
      data-slot="link"
      hidden>{t("ficha.condiciones.enlace")}</a
    >
  </div>
</template>

<script>
  import {
    FIELDS,
    addGroups,
    announce,
    canAdd,
    cellView,
    conditionTitle,
    emptyText,
    fieldLabel,
    focusAfterRemove,
    headerView,
    modelsToFetch,
    noticeParagraphs,
    numberNotes,
    parseEntries,
    validateSelection,
    versionOptions,
    withAdded,
    withVersion,
    withoutColumn,
    writeSearch,
    type ColumnKey,
    type IndexEntry,
    type PublishedModel,
    type PublishedVersion,
  } from "../lib/compare.ts";
  import { t } from "../lib/i18n.ts";
  import { noteLine, type SourceNote } from "../lib/notes.ts";

  const main = document.querySelector<HTMLElement>("main[data-messages]");
  const section = document.querySelector<HTMLElement>("[data-compare]");
  if (main && section) void init(main, section);

  /** Clones the first element of `<template data-tpl="name">`. */
  function clone(name: string): HTMLElement {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-tpl="${name}"]`)!;
    return tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
  }
  const slot = (root: ParentNode, name: string) => root.querySelector<HTMLElement>(`[data-slot="${name}"]`)!;
  const show = (el: HTMLElement, text: string | null) => {
    el.hidden = text === null;
    if (text !== null) el.textContent = text;
  };

  /** A model's JSON, or null if there is none (404: unknown or not comparable, RF-11). */
  async function fetchModel(key: { brand: string; slug: string }): Promise<PublishedModel | null> {
    const res = await fetch(`/comparar/datos/${encodeURIComponent(key.brand)}/${encodeURIComponent(key.slug)}.json`);
    if (res.status === 404) return null;
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    return (await res.json()) as PublishedModel;
  }

  async function init(main: HTMLElement, section: HTMLElement) {
    const entries = parseEntries(location.search);
    const noJs = document.querySelector<HTMLElement>("[data-no-js]");
    const loading = document.querySelector<HTMLElement>("[data-loading]")!;
    // Loading state (RNF-6): only the status text, no table or list yet.
    noJs?.remove();
    loading.hidden = false;
    let models: PublishedModel[];
    try {
      // All requests at once; only the models the URL names are fetched (ADR-0014).
      const found = await Promise.all(modelsToFetch(entries).map(fetchModel));
      models = found.filter((m): m is PublishedModel => m !== null);
    } catch {
      // Error state (RNF-6): our own message and a link, never the browser's error; no table.
      loading.hidden = true;
      document.querySelector<HTMLElement>("[data-error]")!.hidden = false;
      return;
    }
    loading.hidden = true;

    const selection = validateSelection(entries, models);
    for (const m of models) loaded.set(`${m.brand}/${m.slug}`, m);
    columns = selection.columns;
    renderNotice(selection);
    update();
    wireForm();
    // The index is requested apart: if it fails only «Añadir» fails, the table is already there.
    try {
      const res = await fetch("/comparar/datos/indice.json");
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      catalogue = (await res.json()) as IndexEntry[];
    } catch {
      catalogue = null;
    }
    renderAddOptions();
  }

  // State of the page: the columns (the only truth), the models fetched so far and the index.
  let columns: ColumnKey[] = [];
  const loaded = new Map<string, PublishedModel>();
  let catalogue: IndexEntry[] | null = null;
  const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;

  const pickedNow = () =>
    columns.map((c) => {
      const model = loaded.get(`${c.brand}/${c.slug}`)!;
      return { model, version: model.versions.find((v) => v.name === c.name)! };
    });

  type Focus = { kind: "select" | "remove" | "item"; index: number } | { kind: "add" } | null;

  /**
   * Redraws everything from `columns`: URL (RF-10), list, «Añadir», and table with notes and sources
   * (or nothing with fewer than 2, RF-12). Then announces and moves the focus (never to the body).
   */
  function update(message: string | null = null, focus: Focus = null) {
    history.replaceState(null, "", location.pathname + (columns.length ? `?${writeSearch(columns)}` : ""));
    const picked = pickedNow();
    renderChosen(picked);
    renderAddOptions();
    const compare = $("[data-compare]");
    const sources = $("[data-sources]");
    if (columns.length < 2) {
      compare.hidden = true;
      sources.hidden = true;
    } else {
      render(compare, picked);
      compare.hidden = false;
    }
    if (message !== null) {
      const status = $("[data-status]");
      status.textContent = "";
      status.textContent = message;
    }
    if (!focus) return;
    const items = [...document.querySelectorAll<HTMLElement>("[data-chosen-list] > li")];
    if (focus.kind === "add") $("[data-add-select]").focus();
    else if (focus.kind === "item") items[focus.index]?.focus();
    else items[focus.index]?.querySelector<HTMLElement>(`[data-slot="${focus.kind}"]`)?.focus();
  }

  /** RF-9: «Añadir» is a form the script intercepts, or the maximum text; never a disabled control. */
  function renderAddOptions() {
    const form = $("[data-add-form]");
    const open = canAdd(columns.length);
    form.hidden = !open;
    $("[data-max-text]").hidden = open;
    if (!open) return;
    const select = $<HTMLSelectElement>("[data-add-select]");
    const first = select.options[0]!; // «Elige un coche»
    select.replaceChildren(first);
    for (const g of catalogue ? addGroups(catalogue, columns) : []) {
      const group = document.createElement("optgroup");
      group.label = g.label;
      for (const o of g.options) {
        const opt = document.createElement("option");
        opt.value = o.value;
        opt.textContent = o.label;
        opt.disabled = o.disabled;
        group.append(opt);
      }
      select.append(group);
    }
    select.value = "";
  }

  function setAddMessage(text: string | null) {
    const select = $<HTMLSelectElement>("[data-add-select]");
    show($("[data-add-message]"), text);
    if (text === null) {
      select.removeAttribute("aria-invalid");
      select.removeAttribute("aria-describedby");
    } else {
      select.setAttribute("aria-invalid", "true");
      select.setAttribute("aria-describedby", "cmp-anadir-msg");
    }
  }

  /** RF-8, RF-9: adds the chosen model at the end with its default (or next free) version. */
  function wireForm() {
    $("[data-add-form]").addEventListener("submit", async (event) => {
      event.preventDefault();
      const select = $<HTMLSelectElement>("[data-add-select]");
      setAddMessage(null);
      if (!select.value) {
        setAddMessage(t("comparador.anadir.sinEleccion"));
        select.focus();
        return;
      }
      if (!canAdd(columns.length)) return;
      const [brand, slug] = select.value.split("/") as [string, string];
      try {
        let model = loaded.get(select.value) ?? null;
        if (!model) {
          model = await fetchModel({ brand, slug });
          if (model) loaded.set(select.value, model);
        }
        if (!model) throw new Error("not comparable");
        const next = withAdded(columns, model);
        if (next.length === columns.length) return;
        columns = next;
        renderNotice({ ignored: 0, tooMany: false }); // the URL notice no longer describes the URL
        const added = columns[columns.length - 1]!;
        update(
          announce("anadido", model, added.name, columns.length),
          { kind: "select", index: columns.length - 1 },
        );
        // A model with one version has no <select>: its <li> takes the focus instead (design).
        const li = document.querySelectorAll<HTMLElement>("[data-chosen-list] > li")[columns.length - 1]!;
        if (!li.querySelector("select")) li.focus();
      } catch {
        // Reuses the page's error text (#322); the table stays as it was.
        setAddMessage(t("comparador.error"));
      }
    });
  }

  /** RF-11: the notice above «Coches comparados», one paragraph per cause; nothing if the URL was fine. */
  function renderNotice(selection: Parameters<typeof noticeParagraphs>[0]) {
    const box = document.querySelector<HTMLElement>("[data-url-notice]")!;
    const proto = box.querySelector<HTMLElement>("[data-notice-p]")!;
    const paragraphs = noticeParagraphs(selection).map((text) => {
      const p = proto.cloneNode(true) as HTMLElement;
      p.hidden = false;
      p.querySelector("[data-notice-text]")!.textContent = text;
      return p;
    });
    box.replaceChildren(...paragraphs);
    box.hidden = paragraphs.length === 0;
  }

  /** «Coches comparados» (RF-12): the cars, and with fewer than 2 the explanation and the catalogue link. */
  function renderChosen(picked: { model: PublishedModel; version: PublishedVersion }[]) {
    const chosen = document.querySelector<HTMLElement>("[data-chosen]")!;
    const list = chosen.querySelector<HTMLElement>("[data-chosen-list]")!;
    list.replaceChildren(
      ...picked.map(({ model, version }, i) => {
        const li = clone("chosen");
        slot(li, "title").textContent = `${model.brand_name} ${model.model}`;
        const select = slot(li, "select") as HTMLSelectElement;
        if (model.versions.length >= 2) {
          select.id = `cmp-version-${i + 1}`;
          (slot(li, "label") as HTMLLabelElement).htmlFor = select.id;
          slot(li, "label").textContent = t("comparador.version.rotulo");
          select.setAttribute(
            "aria-label",
            t("comparador.version.sr", { marca: model.brand_name, modelo: model.model, n: i + 1 }),
          );
          for (const o of versionOptions(model, columns, i)) {
            const opt = document.createElement("option");
            opt.value = o.name;
            opt.textContent = o.label;
            opt.disabled = o.disabled;
            opt.selected = o.name === version.name;
            select.append(opt);
          }
          // RF-8: applied at once; the focus stays on this <select> (WCAG 3.2.2).
          select.addEventListener("change", () => {
            columns = withVersion(columns, i, select.value);
            renderNotice({ ignored: 0, tooMany: false });
            update(announce("cambio", model, columns[i]!.name, i + 1), { kind: "select", index: i });
          });
        } else {
          slot(li, "wrap").remove();
          show(slot(li, "single"), t("comparador.version.unica", { nombre: version.name }));
        }
        const remove = slot(li, "remove");
        slot(remove, "removeText").textContent = t("comparador.quitar");
        slot(remove, "removeSr").textContent = ` ${t("comparador.quitarSr", { marca: model.brand_name, modelo: model.model, nombre: version.name })}`;
        remove.addEventListener("click", () => {
          const gone = columns[i]!;
          columns = withoutColumn(columns, i);
          renderNotice({ ignored: 0, tooMany: false });
          const target = focusAfterRemove(i, columns.length);
          update(
            announce("quitado", model, gone.name, columns.length),
            target.kind === "add" ? target : { kind: "remove", index: target.index },
          );
        });
        return li;
      }),
    );
    list.hidden = picked.length === 0; // no empty <ol>
    const text = emptyText(picked.length);
    show(chosen.querySelector<HTMLElement>("[data-empty-text]")!, text);
    chosen.querySelector<HTMLElement>("[data-empty-link]")!.hidden = text === null;
    chosen.hidden = false;
  }

  /** Mark «[n]» to the entry in «Fuentes», plus «fuente no oficial» for non-T1 data. */
  function makeMark(note: SourceNote): HTMLElement {
    const mark = clone("mark");
    const a = slot(mark, "markLink") as HTMLAnchorElement;
    a.href = `#cmp-fuente-${note.n}`;
    a.setAttribute("aria-label", t("ficha.nota.sr", { n: note.n }));
    slot(a, "markText").textContent = t("ficha.nota.marca", { n: note.n });
    const un = slot(mark, "markUnofficial");
    // The leading space keeps the text apart from the mark; not a separate flow element.
    show(un, note.unofficial ? ` ${t("ficha.nota.noOficial")}` : null);
    return mark;
  }

  function render(section: HTMLElement, picked: { model: PublishedModel; version: PublishedVersion }[]) {
    const n = picked.length;
    const { notes, columns: marks } = numberNotes(picked);
    const table = clone("table");
    table.style.maxWidth = `calc(${n} * var(--width-version-col-max))`;
    slot(table, "caption").textContent = t("comparador.tabla.caption", { n });

    const head = slot(table, "head");
    picked.forEach(({ model, version }, i) => {
      const h = headerView(model, version);
      const th = clone("column");
      th.id = `cmp-col-${i + 1}`;
      const a = slot(th, "link") as HTMLAnchorElement;
      a.href = h.href;
      slot(a, "brand").textContent = h.brand;
      slot(a, "model").textContent = h.model;
      slot(a, "sr").textContent = ` ${h.srSuffix}`;
      slot(th, "name").textContent = h.name;
      show(slot(th, "badge"), h.badge);
      for (const num of marks[i]!.header) slot(th, "marks").append(" ", makeMark(notes[num - 1]!));
      head.append(th);
    });

    for (const field of FIELDS) {
      const body = clone("field");
      const label = slot(body, "label");
      label.id = `cmp-f-${field}`;
      label.setAttribute("colspan", String(n));
      label.textContent = fieldLabel(field);
      const values = slot(body, "values");
      picked.forEach(({ version }, i) => {
        const c = cellView(field, version);
        const num = marks[i]!.cells[field];
        const td = clone("cell");
        td.setAttribute("headers", `cmp-col-${i + 1} cmp-f-${field}`);
        const text = slot(td, "text");
        text.textContent = c.text;
        // Same style for every value: only the placeholder is muted, and it also reads as text (CA-17).
        text.className = c.missing ? "text-ink-600" : field === "precio" ? "text-price text-ink-900" : "";
        if (num !== undefined) text.append(" ", makeMark(notes[num - 1]!));
        slot(td, "dealRow").hidden = c.deal === null;
        if (c.deal) slot(td, "deal").textContent = c.deal;
        const source = slot(td, "source");
        source.hidden = c.source === null;
        if (c.source) {
          const MARK = "\u0001";
          const [before, after = ""] = t("ficha.precio.fuente", { fuente: MARK, fecha: c.source.date }).split(MARK);
          slot(source, "before").textContent = before!;
          const link = slot(source, "sourceLink") as HTMLAnchorElement;
          link.href = c.source.url;
          link.textContent = c.source.name;
          slot(source, "after").textContent = after;
          show(slot(source, "unofficial"), c.unofficial ? t("ficha.nota.noOficial") : null);
        }
        show(slot(td, "note"), c.note);
        const terms = slot(td, "terms") as HTMLAnchorElement;
        terms.hidden = c.terms === null;
        if (c.terms) terms.href = `#cmp-condiciones-${i + 1}`;
        values.append(td);
      });
      table.append(body);
    }
    section.querySelector("[data-table-host]")!.replaceChildren(table);

    const list = section.querySelector<HTMLElement>("[data-conditions-list]")!;
    list.replaceChildren();
    picked.forEach(({ model, version }, i) => {
      const terms = cellView("precio", version).terms;
      if (!terms) return;
      const entry = clone("condition");
      entry.id = `cmp-condiciones-${i + 1}`;
      slot(entry, "title").textContent = conditionTitle(model, version);
      show(slot(entry, "text"), terms.text);
      const link = slot(entry, "link") as HTMLAnchorElement;
      link.hidden = !terms.url;
      if (terms.url) link.href = terms.url;
      list.append(entry);
    });
    section.querySelector<HTMLElement>("[data-conditions]")!.hidden = list.children.length === 0;

    // «Fuentes» exists only with 2 or 3 versions; the table is only rendered then, so show it here.
    const sources = document.querySelector<HTMLElement>("[data-sources]")!;
    const items = notes.map((note) => {
      const li = clone("source");
      li.id = `cmp-fuente-${note.n}`;
      slot(li, "line").textContent = noteLine(note);
      const a = slot(li, "link") as HTMLAnchorElement;
      a.href = note.url;
      a.textContent = note.url;
      return li;
    });
    sources.querySelector("[data-sources-list]")!.replaceChildren(...items);
    sources.hidden = false;
  }
</script>
