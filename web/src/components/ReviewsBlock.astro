---
import { t } from "../lib/i18n.ts";
import { formatDate, sourceName } from "../lib/format.ts";
import type { Review } from "../lib/data.ts";

/**
 * «Reviews» block (PRD-002 RF-16, PRD-006 RF-10; docs/design/ficha-modelo.md). Last block of the model page.
 * It only renders when there is something to show. Each entry is a link with title, outlet, domain,
 * retrieval date and optional version (#599). Entry order is #600.
 * The «Resultados de pruebas» sublist, and the h3 of both sublists when there are two, are #601: no
 * test result can be published until the first metric exists (#597), so that branch could not be tested here.
 */
interface Props {
  reviews: Review[];
  brand: string;
  model: string;
}
const { reviews, brand, model } = Astro.props as Props;
// A review without outlet cannot be shown (data.ts): it counts as not publishable.
const media = reviews.filter((r) => r.outlet !== null);
---

{
  media.length > 0 && (
    <section aria-labelledby="reviews" class="mt-12" data-reviews>
      <h2 id="reviews" class="text-section text-ink-900">{t("ficha.reviews.titulo")}</h2>
      <div class="mt-4 max-w-prose" data-reviews-medios>
        <p class="mt-1 text-small text-ink-600">{t("ficha.reviews.mediosEntrada")}</p>
        <ul class="mt-4 flex flex-col gap-4">
          {media.map((r) => (
            <li class="border-t border-line-soft pt-4 first:border-t-0 first:pt-0">
              <a
                href={r.url}
                rel="noopener"
                class="block min-h-touch text-body font-semibold text-brand-600 underline hover:text-brand-800 [overflow-wrap:anywhere]"
                >{r.title}<span class="sr-only"> {t("ficha.reviews.enlaceSr", { medio: r.outlet!, marca: brand, modelo: model })}</span></a
              >
              <p class="text-small text-ink-600 [overflow-wrap:anywhere]">
                {t("ficha.reviews.origen", {
                  medio: r.outlet!,
                  dominio: sourceName(r.url) ?? r.url,
                  fecha: formatDate(r.retrieved) ?? r.retrieved,
                })}
              </p>
              {r.version && (
                <p class="text-small text-ink-600 [overflow-wrap:anywhere]">{t("ficha.reviews.version", { version: r.version })}</p>
              )}
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}
