---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { imageRelPath, type ModelImage } from "../lib/data.ts";
import CutoutPhoto from "./CutoutPhoto.astro";

/**
 * One licensed image of the model page (docs/design/ficha-modelo.md, RF-12): 16:9 figure with a
 * caption only when the data has an attribution. All text arrives by props (RNF-4).
 */
interface Props {
  image: ModelImage;
  alt: string;
  /** Already composed caption, or null for no <figcaption>. */
  caption: string | null;
  /** Main image: LCP candidate, so eager with high priority. */
  main?: boolean;
}
const { image, alt, caption, main = false } = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>("@images/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}", { eager: true });
// A retouched image (an `edits` entry) is the car cut out on transparency: shown whole, never with cover.
// The main image is handled by the first screen, so this is only for «Más imágenes».
const cutout = !main && image.edits.length > 0;
const rel = imageRelPath(image.file);
const src = rel ? Object.entries(files).find(([key]) => key.endsWith(`/${rel}`))?.[1].default : undefined;
---

{
  src && (
    <figure class="flex flex-col gap-2">
      {cutout ? (
        <div class="more-cutout aspect-video overflow-hidden rounded-card" data-more-cutout>
          <CutoutPhoto
            src={src}
            alt={alt}
            widths={[320, 640, 960]}
            sizes="(min-width: 1440px) 475px, (min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            loading="lazy"
          />
        </div>
      ) : (
      <div class="aspect-video overflow-hidden rounded-card bg-surface-muted">
        {main ? (
          <Image
            src={src}
            alt={alt}
            width={1280}
            height={720}
            widths={[640, 960, 1280]}
            sizes="(min-width: 1440px) 835px, (min-width: 1024px) 58vw, 100vw"
            loading="eager"
            fetchpriority="high"
            class="h-full w-full object-cover"
          />
        ) : (
          <Image
            src={src}
            alt={alt}
            width={640}
            height={360}
            widths={[320, 640, 960]}
            sizes="(min-width: 1440px) 475px, (min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
            loading="lazy"
            class="h-full w-full object-cover"
          />
        )}
      </div>
      )}
      {caption && <figcaption class="text-small text-ink-600 [overflow-wrap:anywhere]">{caption}</figcaption>}
    </figure>
  )
}

<style is:global>
  /* ink-950 in every band, with room so the roof and mirrors never touch the edge. */
  .more-cutout {
    background: var(--color-ink-950);
    padding: 0.75rem 0.75rem 0.25rem;
  }
  .more-cutout .cutout-photo {
    height: 100%;
  }
</style>
