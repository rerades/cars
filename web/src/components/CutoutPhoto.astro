---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * A retouched image (ADR-0025, RF-15): the car cut out on transparency, shown whole (contain) and resting on the
 * bottom of its box, over the dark band's own ink-950 and a faint floor. Only the common colour filter of the
 * photos: no tone, vignette or scrim, because the box never sits under text.
 * Always served as WebP (with alpha), never the original PNG (RNF-2). The parent positions the box.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}
const { src, alt, widths, sizes, loading = "lazy", fetchpriority } = Astro.props;
---

<div class="cutout-photo" data-cutout>
  <Image src={src} alt={alt} format="webp" widths={widths} sizes={sizes} loading={loading} fetchpriority={fetchpriority} />
</div>

<style is:global>
  .cutout-photo {
    background: radial-gradient(ellipse 60% 22% at 50% 88%, var(--color-cutout-floor), transparent 70%);
    pointer-events: none;
  }
  .cutout-photo img {
    display: block;
    filter: saturate(0.72) contrast(1.06) brightness(0.86);
    height: 100%;
    object-fit: contain;
    object-position: 50% 100%;
    width: 100%;
  }
</style>
