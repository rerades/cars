---
import "../styles/global.css";
import ExploreStrip from "../components/ExploreStrip.astro";
import { exploreGroups, homeCountLabel } from "../lib/catalog.ts";
import { loadModels } from "../lib/data.ts";
import { t } from "../lib/i18n.ts";

// Same published models as the list of /coches (loadModels leaves out needs_review, PRD-001 RF-13).
const { models, errors } = loadModels();

// Unreadable files are internal ingestion news: build log only, never the page (PRD-004 decision 6, ADR-0010).
if (errors.length > 0) {
  console.warn(`[portada] No se pudieron leer ${errors.length} ficheros de data/: ${errors.map((e) => e.file).join(", ")}`);
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("pagina.portada.tituloDocumento")}</title>
  </head>
  <body>
    {/* Same dark band header as CatalogPage (paginas-catalogo.md); nothing beyond portada.md (RF-5, RF-8). */}
    <header class="band-dark">
      <div class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8">
        <h1 class="text-display font-bold leading-[0.98] [font-stretch:var(--font-stretch-wide)] [overflow-wrap:anywhere]">{t("sitio.nombre")}</h1>
        <p class="mt-4 max-w-prose text-body text-ink-600" data-intro>{t("pagina.portada.entrada")}</p>
        {models.length > 0 && <p class="mt-3 text-body text-ink-600" data-count>{homeCountLabel(models.length)}</p>}
      </div>
    </header>
    <main>
      <div class="mx-auto max-w-page px-4 pb-8 md:px-6 lg:px-8">
        {
          models.length > 0 ? (
            <ExploreStrip groups={exploreGroups(models, "")} showAll={true} />
          ) : (
            <p class="mt-3 text-body text-ink-900" data-empty-catalog>{t("vacio.catalogo.texto")}</p>
          )
        }
      </div>
    </main>
  </body>
</html>
