---
import "../../../styles/global.css";
import { cardView, type CardView } from "../../../lib/card.ts";
import ModelFigure from "../../../components/ModelFigure.astro";
import SegmentSilhouette from "../../../components/SegmentSilhouette.astro";
import { loadModels, type ModelImage, type Sourced, type Specs, type Version } from "../../../lib/data.ts";
import { t, type MessageKey } from "../../../lib/i18n.ts";
import { chunkVersions, sortVersions } from "../../../lib/versions.ts";
import { relatedModels } from "../../../lib/related.ts";
import ModelCard from "../../../components/ModelCard.astro";
import VersionPrice from "../../../components/VersionPrice.astro";
import VersionField from "../../../components/VersionField.astro";
import { versionFields } from "../../../lib/version-fields.ts";

/**
 * Model page (PRD-002, docs/design/ficha-modelo.md). This story: URL, title and header (RF-1, RF-2,
 * RF-10). Later stories add their blocks as sibling <section>s after the header inside <main>.
 */
export function getStaticPaths() {
  const { models } = loadModels();
  return models.map((model) => {
    const [marca, file] = model.file.replace(/\.yaml$/, "").split("/");
    const related = relatedModels(model, models).map((m) => cardView(m));
    return { params: { marca, modelo: file }, props: { card: cardView(model), versions: sortVersions(model.versions), brandSlug: marca, brandUrl: model.status.url, images: model.images, specs: model.specs, related } };
  });
}

const { card, versions, brandSlug, brandUrl, images, specs, related } = Astro.props as {
  card: CardView;
  versions: Version[];
  brandSlug: string;
  brandUrl: string;
  images: ModelImage[];
  specs: Specs;
  related: CardView[];
};
const chunks = chunkVersions(versions);
// Technical rows after the price (RF-5, RF-6): same list for the table and the blocks.
const fieldsOf = (v: Version) => versionFields(v);
const fieldRows = versions.length > 0 ? fieldsOf(versions[0]!) : [];
const discontinued = card.statusKind === "discontinued";
// Financed versions in version order; their position is the n of #condiciones-{n} (RF-4, CA-4).
const financed = versions.filter((v) => v.price?.price_kind === "financed");
const termsIndex = (v: Version) => {
  const i = financed.indexOf(v);
  return i < 0 ? undefined : i + 1;
};
const paragraphs = (text: string) => text.split(/\n\s*\n/).filter((p) => p.trim() !== "");
// readImages (data.ts) already drops any image without license or source_id.
const total = Math.min(images.length, 6);
const altOf = (i: number) => t("ficha.imagen.alt", { marca: card.brand, modelo: card.model, i, n: total });
const captionOf = (img: ModelImage) =>
  img.attribution ? t("ficha.imagen.atribucion", { attribution: img.attribution }) : null;
const [mainImage, ...rest] = images.slice(0, 6);

// "Datos del modelo" (RF-7): only the rows `specs` carries, in the order of the design table.
const sep = ` ${t("ficha.lista.separador")} `;
const rows: { key: string; label: string; text: string; note?: string }[] = [];
const addRow = <T,>(key: keyof Specs, label: MessageKey, value: Sourced<T> | undefined, fmt: (v: T) => string) => {
  if (value) rows.push({ key, label: t(label), text: fmt(value.value), note: value.note });
};
addRow("wltp_max_km", "ficha.modelo.autonomia", specs.wltp_max_km, (n) => t("ficha.unidad.km", { n }));
addRow("power_max_kw", "ficha.modelo.potencia", specs.power_max_kw, (n) => t("ficha.unidad.kw", { n }));
addRow("dc_max_kw", "ficha.modelo.cargaCc", specs.dc_max_kw, (n) => t("ficha.unidad.kw", { n }));
addRow("ac_max_kw", "ficha.modelo.cargaCa", specs.ac_max_kw, (n) => t("ficha.unidad.kw", { n }));
addRow("battery_kwh_options", "ficha.modelo.baterias", specs.battery_kwh_options, (l) =>
  l.map((n) => t("ficha.unidad.kwh", { n })).join(sep),
);
addRow("drivetrains", "ficha.modelo.tracciones", specs.drivetrains, (l) =>
  l.map((d) => t(`traccion.${d}` as MessageKey)).join(sep),
);
const modelRows = rows;
const heading = t("ficha.titulo", { marca: card.brand, modelo: card.model });
const site = t("sitio.nombre");
const documentTitle = site ? t("pagina.tituloDocumento", { titulo: heading, sitio: site }) : heading;
const canonical = new URL(`/marcas/${card.key}/`, Astro.site).href;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <main class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8">
      <nav aria-label={t("ficha.ruta.nombre")} data-ficha-ruta>
        <ol class="flex flex-wrap items-center text-small">
          <li class="flex items-center after:mx-2 after:text-ink-600 after:[content:'›'/'']">
            <a
              href="/coches"
              class="inline-flex min-h-touch items-center text-brand-600 underline hover:text-brand-800"
              >{t("ficha.ruta.coches")}</a
            >
          </li>
          <li class="flex items-center after:mx-2 after:text-ink-600 after:[content:'›'/'']">
            <a
              href={`/marcas/${brandSlug}/`}
              class="inline-flex min-h-touch items-center text-brand-600 underline hover:text-brand-800 [overflow-wrap:anywhere]"
              >{card.brand}</a
            >
          </li>
          <li aria-current="page" class="text-ink-600 [overflow-wrap:anywhere]">{card.model}</li>
        </ol>
      </nav>
      <header data-ficha-header class="flex flex-col gap-6 lg:grid lg:grid-cols-12 lg:items-start lg:gap-8">
        <div class="lg:col-span-5">
          <h1 class="text-title text-ink-900 [overflow-wrap:anywhere]">{heading}</h1>
          <dl class="mt-3 flex flex-col gap-2">
            {
              card.statusLabel && (
                <div>
                  <dt class="sr-only">{t("ficha.estado.rotulo")}</dt>
                  <dd>
                    <span
                      class:list={[
                        "inline-block rounded-full px-3 py-1 text-badge",
                        card.statusKind === "soon"
                          ? "bg-soon-bg text-soon-fg"
                          : "bg-discontinued-bg text-discontinued-fg",
                      ]}
                      data-status={card.statusKind}>{card.statusLabel}</span
                    >
                  </dd>
                </div>
              )
            }
            <div class="flex flex-wrap gap-x-2">
              <dt class:list={["text-body text-ink-600", !card.hasSegment && "sr-only"]}>{t("ficha.segmento.rotulo")}</dt>
              <dd class:list={["text-body", card.hasSegment ? "text-ink-900" : "text-ink-600"]} data-field="segment">
                {card.segmentLabel}
              </dd>
            </div>
          </dl>
          <a
            href={brandUrl}
            rel="noopener"
            data-web-marca
            class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
            >{t("ficha.webMarca")}<span class="sr-only"> {t("ficha.webMarcaSr", { marca: card.brand })}</span></a
          >
        </div>
        <div class="lg:col-span-7" data-main-image>
          {
            mainImage ? (
              <ModelFigure image={mainImage} alt={altOf(1)} caption={captionOf(mainImage)} main />
            ) : (
              <div
                class="flex aspect-video items-center justify-center overflow-hidden rounded-card bg-surface-muted text-line"
                data-slot="silhouette"
              >
                <SegmentSilhouette segment={card.segment} large />
              </div>
            )
          }
        </div>
      </header>

      <section aria-labelledby="versiones-titulo" class="mt-8" data-ficha-versiones>
        <h2 id="versiones-titulo" class="text-section text-ink-900">{t("ficha.versiones.titulo")}</h2>
        {
          versions.length === 0 ? (
            <p class="mt-3 text-body text-ink-900" data-versiones-vacio>
              {t("ficha.versiones.vacio", { marca: card.brand })}
            </p>
          ) : (
            <>
              <p class="mt-1 text-small text-ink-600">{t("ficha.versiones.entrada")}</p>

              {/* Wide screens (lg): comparison table(s). No ids inside: the blocks below repeat the same content. */}
              <div class="mt-4 hidden flex-col gap-6 lg:flex" data-versiones-tabla>
                {chunks.map((chunk) => (
                  <table class="w-full table-fixed border-collapse text-left">
                    <caption class="sr-only">
                      {chunks.length === 1
                        ? t("ficha.versiones.caption", { marca: card.brand, modelo: card.model })
                        : t("ficha.versiones.captionParte", {
                            marca: card.brand,
                            modelo: card.model,
                            desde: chunk.from,
                            hasta: chunk.to,
                            total: versions.length,
                          })}
                    </caption>
                    <thead>
                      <tr>
                        <td class="w-(--width-version-label) bg-surface-muted p-3" />
                        {chunk.items.map((version) => (
                          <th
                            scope="col"
                            class="min-w-(--width-version-col) max-w-(--width-version-col-max) bg-surface-muted p-3 align-top text-card-title text-ink-900 [overflow-wrap:anywhere]"
                          >
                            {version.name}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    {/* Field rows come in the order of «Campos y formato»: price (#149), then the rest (#150). */}
                    <tbody>
                      <tr class="border-t border-line-soft">
                        <th scope="row" class="bg-surface-muted p-3 align-top text-body text-ink-900">
                          {t("ficha.campo.precio")}
                        </th>
                        {chunk.items.map((version) => (
                          <td class="bg-surface p-3 align-top [overflow-wrap:anywhere]">
                            <VersionPrice price={version.price} discontinued={discontinued} termsIndex={termsIndex(version)} />
                          </td>
                        ))}
                      </tr>
                      {fieldRows.map((row, i) => (
                        <tr class="border-t border-line-soft">
                          <th scope="row" class="bg-surface-muted p-3 align-top text-body text-ink-900">
                            {row.label}
                          </th>
                          {chunk.items.map((version) => (
                            <td class="bg-surface p-3 align-top [overflow-wrap:anywhere]">
                              <VersionField field={fieldsOf(version)[i]} />
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                ))}
              </div>

              {/* Mobile and md: one block per version, same order. No ids. */}
              <ol class="mt-4 grid gap-4 md:grid-cols-2 lg:hidden" data-versiones-bloques>
                {versions.map((version) => (
                  <li class="rounded-card border border-line-soft bg-surface p-4">
                    <h3 class="text-card-title text-ink-900 [overflow-wrap:anywhere]">{version.name}</h3>
                    {/* The <dl> fields follow the table rows' order: price (#149), then the rest (#150). */}
                    <dl class="mt-3 flex flex-col gap-3 [overflow-wrap:anywhere]">
                      <div>
                        <dt class="text-small text-ink-600">{t("ficha.campo.precio")}</dt>
                        <dd class="text-body text-ink-900">
                          <VersionPrice price={version.price} discontinued={discontinued} termsIndex={termsIndex(version)} />
                        </dd>
                      </div>
                      {versionFields(version).map((field) => (
                        <div>
                          <dt class="text-small text-ink-600">{field.label}</dt>
                          <dd class="text-body text-ink-900">
                            <VersionField field={field} />
                          </dd>
                        </div>
                      ))}
                    </dl>
                  </li>
                ))}
              </ol>

              {/* Offer terms: once, outside the table and the blocks, always visible (CA-4). Ids live here. */}
              {
                financed.length > 0 && (
                  <div class="mt-8" data-condiciones>
                    <h3 class="text-card-title text-ink-900">{t("ficha.condiciones.titulo")}</h3>
                    <ul class="mt-3 flex flex-col gap-6">
                      {financed.map((version, i) => (
                        <li id={`condiciones-${i + 1}`} tabindex="-1" class="max-w-prose">
                          <p class="text-body font-semibold text-ink-900 [overflow-wrap:anywhere]">{version.name}</p>
                          <div class="mt-1 flex flex-col gap-2 text-small text-ink-900 [overflow-wrap:anywhere]">
                            {paragraphs(version.price!.price_terms ?? "").map((p) => (
                              <p class="whitespace-pre-line">{p}</p>
                            ))}
                          </div>
                          <a
                            href={version.price!.price_terms_url}
                            rel="noopener"
                            class="mt-1 inline-flex min-h-touch items-center text-small text-brand-600 underline hover:text-brand-800"
                            >{t("ficha.condiciones.enlace")}</a
                          >
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
            </>
          )
        }
      </section>


      {
        modelRows.length > 0 && (
          <section aria-labelledby="datos-modelo" class="mt-10" data-ficha-modelo>
            <h2 id="datos-modelo" class="text-section text-ink-900">{t("ficha.modelo.titulo")}</h2>
            <p class="mt-1 text-small text-ink-600">{t("ficha.modelo.entrada")}</p>
            <dl class="mt-4 grid max-w-prose grid-cols-1 gap-4 md:grid-cols-2">
              {modelRows.map((row) => (
                <div data-spec={row.key}>
                  <dt class="text-small text-ink-600">{row.label}</dt>
                  <dd class="text-body text-ink-900">{row.text}</dd>
                  {row.note && <dd class="text-small text-ink-600">{row.note}</dd>}
                </div>
              ))}
            </dl>
          </section>
        )
      }

      {
        rest.length > 0 && (
          <section aria-labelledby="mas-imagenes" class="mt-8" data-more-images>
            <h2 id="mas-imagenes" class="text-section text-ink-900">{t("ficha.imagenes.titulo")}</h2>
            <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
              {rest.map((img, i) => (
                <li>
                  <ModelFigure image={img} alt={altOf(i + 2)} caption={captionOf(img)} />
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        card.hasSegment && related.length > 0 && (
          <section aria-labelledby="relacionados" class="mt-12" data-related>
            <h2 id="relacionados" class="text-section text-ink-900 [overflow-wrap:anywhere]">
              {t("ficha.relacionados.titulo", { segmento: card.segmentLabel })}
            </h2>
            <ul class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3">
              {related.map((r) => (
                <ModelCard card={r} href={`/marcas/${r.key}/`} />
              ))}
            </ul>
          </section>
        )
      }
    </main>
  </body>
</html>
