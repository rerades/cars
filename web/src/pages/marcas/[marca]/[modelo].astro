---
import "../../../styles/global.css";
import { cardView, type CardView } from "../../../lib/card.ts";
import ModelFigure from "../../../components/ModelFigure.astro";
import SegmentSilhouette from "../../../components/SegmentSilhouette.astro";
import ReviewsStrip from "../../../components/ReviewsStrip.astro";
import SourcesBlock from "../../../components/SourcesBlock.astro";
import SegmentSource from "../../../components/SegmentSource.astro";
import Cifra from "../../../components/Cifra.astro";
import CifrasCountUp from "../../../components/CifrasCountUp.astro";
import SourceDate from "../../../components/SourceDate.astro";
import { batteryFigure, powerFigure } from "../../../lib/key-figures.ts";
import { formatDecimal, formatEur, formatNumber } from "../../../lib/format.ts";
import { loadModels, type ModelImage, type Price,type Review, type Sourced, type TestResult, type Specs, type Version } from "../../../lib/data.ts";
import { t, type MessageKey } from "../../../lib/i18n.ts";
import { sortVersions } from "../../../lib/versions.ts";
import { relatedModels } from "../../../lib/related.ts";
import ModelData from "../../../components/ModelData.astro";
import MoreImages from "../../../components/MoreImages.astro";
import SegmentRelated from "../../../components/SegmentRelated.astro";
import VersionBlock from "../../../components/VersionBlock.astro";
import SourceMark from "../../../components/SourceMark.astro";
import { versionFields } from "../../../lib/version-fields.ts";
import { groupNotes, noteLine } from "../../../lib/notes.ts";
import type { ImageMetadata } from "astro";
import SectionMenu from "../../../components/SectionMenu.astro";
import ScreenPhoto from "../../../components/ScreenPhoto.astro";
import { assignBands, bandClass } from "../../../lib/bands.ts";
import { publishableResults } from "../../../lib/test-results.ts";
import { imageRelPath } from "../../../lib/data.ts";

/**
 * Model page (PRD-002, docs/design/ficha-modelo.md). This story: URL, title and header (RF-1, RF-2,
 * RF-10). Later stories add their blocks as sibling <section>s after the header inside <main>.
 */
export function getStaticPaths() {
  const { models } = loadModels();
  return models.map((model) => {
    const [marca, file] = model.file.replace(/\.yaml$/, "").split("/");
    const related = relatedModels(model, models).map((m) => cardView(m));
    return { params: { marca, modelo: file }, props: { card: cardView(model), versions: sortVersions(model.versions), brandSlug: marca, brandUrl: model.status.url, status: model.status, launch: model.launch, segment: model.segment, images: model.images, specs: model.specs, related, reviews: model.reviews, testResults: model.test_results, priceFrom: model.price_from, maxRange: model.max_range_km } };
  });
}

const { card, versions, brandSlug, brandUrl, status, launch, segment, images, specs, related, reviews, testResults, priceFrom, maxRange } = Astro.props as {
  priceFrom: Price | null;
  maxRange: Sourced<number> | null;
  reviews: Review[];
  testResults: TestResult[];
  card: CardView;
  status: Sourced;
  launch: Sourced | null;
  segment: Sourced | null;
  versions: Version[];
  brandSlug: string;
  brandUrl: string;
  images: ModelImage[];
  specs: Specs;
  related: CardView[];
};
// Technical fields of a version (RF-5, RF-6), also walked to number the source notes.
const fieldsOf = (v: Version) => versionFields(v);
const discontinued = card.statusKind === "discontinued";
// Financed versions in version order; their position is the n of #condiciones-{n} (RF-4, CA-4).
const financed = versions.filter((v) => v.price?.price_kind === "financed");
const termsIndex = (v: Version) => {
  const i = financed.indexOf(v);
  return i < 0 ? undefined : i + 1;
};
const paragraphs = (text: string) => text.split(/\n\s*\n/).filter((p) => p.trim() !== "");
// readImages (data.ts) already drops any image without license or source_id.
const total = Math.min(images.length, 6);
const altOf = (i: number) => t("ficha.imagen.alt", { marca: card.brand, modelo: card.model, i, n: total });
const captionOf = (img: ModelImage) =>
  img.attribution ? t("ficha.imagen.atribucion", { attribution: img.attribution }) : null;
const [mainImage, ...rest] = images.slice(0, 6);

// "Datos del modelo" (RF-7): only the rows `specs` carries, in the order of the design table.
const sep = ` ${t("ficha.lista.separador")} `;
const rows: { key: string; label: string; text: string; note?: string; datum: Sourced }[] = [];
const addRow = <T,>(key: keyof Specs, label: MessageKey, value: Sourced<T> | undefined, fmt: (v: T) => string) => {
  if (value) rows.push({ key, label: t(label), text: fmt(value.value), note: value.note, datum: value });
};
addRow("wltp_max_km", "ficha.modelo.autonomia", specs.wltp_max_km, (n) => t("ficha.unidad.km", { n }));
addRow("power_max_kw", "ficha.modelo.potencia", specs.power_max_kw, (n) => t("ficha.unidad.kw", { n }));
addRow("dc_max_kw", "ficha.modelo.cargaCc", specs.dc_max_kw, (n) => t("ficha.unidad.kw", { n }));
addRow("ac_max_kw", "ficha.modelo.cargaCa", specs.ac_max_kw, (n) => t("ficha.unidad.kw", { n }));
addRow("battery_kwh_options", "ficha.modelo.baterias", specs.battery_kwh_options, (l) =>
  l.map((n) => t("ficha.unidad.kwh", { n })).join(sep),
);
addRow("drivetrains", "ficha.modelo.tracciones", specs.drivetrains, (l) =>
  l.map((d) => t(`traccion.${d}` as MessageKey)).join(sep),
);
const modelRows = rows;

// Source notes (RF-9): numbered by first appearance in the fixed walk header -> versions (sorted,
// fields in table order, price excluded: it shows its own source) -> model data. The blocks share them.
const headerData: Sourced[] = [];
if (card.statusLabel) headerData.push(status);
if (card.statusKind === "soon" && launch) headerData.push(launch);
// An editorial segment (tier E, ADR-0021) has no note: its url is a PR, not a source for the visitor (CA-20).
if (segment && segment.tier !== "E") headerData.push(segment);
// Key figures of the first screen (RF-18): their data join the walk right after the header. The price shows
// its own source next to the figure, so it is not a note.
const powerDatum = powerFigure(versions, specs);
const batteryDatum = batteryFigure(versions);
const { notes, numberOf } = groupNotes([
  ...headerData,
  maxRange,
  powerDatum,
  batteryDatum,
  ...versions.flatMap((v) => fieldsOf(v).map((f) => f.datum)),
  ...modelRows.map((r) => r.datum),
]);
const markOf = (s: Sourced) => ({ n: numberOf(s), unofficial: s.tier !== "T1" });
const statusMark = card.statusLabel ? markOf(status) : null;
const launchMark = card.statusKind === "soon" && launch ? markOf(launch) : null;
const segmentMark = segment && segment.tier !== "E" ? markOf(segment) : null;
const keyFigures = [
  { id: "range", label: t("ficha.cifras.autonomia"), datum: maxRange, text: maxRange ? t("ficha.unidad.km", { n: formatNumber(maxRange.value) }) : null },
  { id: "power", label: t("ficha.cifras.potencia"), datum: powerDatum, text: powerDatum ? t("ficha.unidad.kw", { n: formatDecimal(powerDatum.value) }) : null },
  { id: "battery", label: t("ficha.cifras.bateria"), datum: batteryDatum, text: batteryDatum ? t("ficha.unidad.kwh", { n: formatDecimal(batteryDatum.value) }) : null },
];
const heading = t("ficha.titulo", { marca: card.brand, modelo: card.model });
const site = t("sitio.nombre");
const documentTitle = site ? t("pagina.tituloDocumento", { titulo: heading, sitio: site }) : heading;
const canonical = new URL(`/marcas/${card.key}/`, Astro.site).href;

// First screen photo (RF-12): the same file lookup as ModelFigure. A file that is not there falls back to the silhouette.
const imageFiles = import.meta.glob<{ default: ImageMetadata }>("@images/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}", { eager: true });
const mainRel = mainImage ? imageRelPath(mainImage.file) : null;
const mainSrc = mainRel ? Object.entries(imageFiles).find(([key]) => key.endsWith(`/${mainRel}`))?.[1].default : undefined;

// Band colours (ficha-modelo.md): the first screen is dark; the rest follow assignBands over the sections that exist.
const hasReviews = reviews.some((r) => r.outlet !== null) || publishableResults(testResults).length > 0;
const sectionIds = [
  "versiones",
  ...(modelRows.length > 0 ? ["datos"] : []),
  ...(rest.length > 0 ? ["imagenes"] : []),
  ...(card.hasSegment && related.length > 0 ? ["relacionados"] : []),
  ...(notes.length > 0 ? ["fuentes"] : []),
  ...(hasReviews ? ["reviews"] : []),
];
const bandColors = assignBands(sectionIds);
const band = (id: string) => bandClass(bandColors[sectionIds.indexOf(id)]!);
// Section menu (RF-17): one anchor per section that exists, in page order, to the id of its heading.
const menuItems = [
  { href: "#cifras", label: t("ficha.menu.cifras") },
  { href: "#versiones-titulo", label: t("ficha.menu.versiones") },
  ...(sectionIds.includes("datos") ? [{ href: "#datos-modelo", label: t("ficha.menu.datos") }] : []),
  ...(sectionIds.includes("imagenes") ? [{ href: "#mas-imagenes", label: t("ficha.menu.imagenes") }] : []),
  ...(sectionIds.includes("relacionados") ? [{ href: "#relacionados", label: t("ficha.menu.relacionados") }] : []),
  ...(sectionIds.includes("fuentes") ? [{ href: "#fuentes", label: t("ficha.menu.fuentes") }] : []),
  ...(sectionIds.includes("reviews") ? [{ href: "#reviews", label: t("ficha.menu.reviews") }] : []),
];
const inner = "mx-auto w-full max-w-page px-4 md:px-6 lg:px-8";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <main>
      <header data-ficha-header class="band-dark hero">
      <div class="hero-screen">
      <div class={`${inner} hero-top`}>
      <nav aria-label={t("ficha.ruta.nombre")} data-ficha-ruta>
        <ol class="flex flex-wrap items-center text-small">
          <li class="flex items-center after:mx-2 after:text-ink-600 after:[content:'›'/'']">
            <a
              href="/coches"
              class="inline-flex min-h-touch items-center text-brand-600 underline hover:text-brand-800"
              >{t("ficha.ruta.coches")}</a
            >
          </li>
          <li class="flex items-center after:mx-2 after:text-ink-600 after:[content:'›'/'']">
            <a
              href={`/marcas/${brandSlug}/`}
              class="inline-flex min-h-touch items-center text-brand-600 underline hover:text-brand-800 [overflow-wrap:anywhere]"
              >{card.brand}</a
            >
          </li>
          <li aria-current="page" class="text-ink-600 [overflow-wrap:anywhere]">{card.model}</li>
        </ol>
      </nav>
      </div>
      <div class="hero-foot"><div class={`${inner} hero-text`}>
          <h1 class="hero-name">
            <span class="hero-brand">{card.brand}</span>{" "}
            <span class="hero-model" data-name={card.model}>{card.model.split(" ").map((w) => <><span class="hero-word">{w}</span>{" "}</>)}</span>
          </h1>
          <dl class="mt-3 flex flex-col gap-2">
            {
              card.statusLabel && (
                <div>
                  <dt class="sr-only">{t("ficha.estado.rotulo")}</dt>
                  <dd>
                    <span
                      class:list={[
                        "inline-block rounded-full px-3 py-1 text-badge",
                        card.statusKind === "soon"
                          ? "bg-soon-bg text-soon-fg"
                          : "bg-discontinued-bg text-discontinued-fg",
                      ]}
                      data-status={card.statusKind}>{card.statusLabel}</span
                    >
                    {statusMark && <SourceMark {...statusMark} />}
                    {launchMark && launchMark.n !== statusMark?.n && <SourceMark {...launchMark} />}
                    {status.note && <p class="text-small text-ink-600" data-note="status">{status.note}</p>}
                    {launchMark && launch?.note && <p class="text-small text-ink-600" data-note="launch">{launch.note}</p>}
                  </dd>
                </div>
              )
            }
            <div class="flex flex-wrap gap-x-2">
              <dt class:list={["text-body text-ink-600", !card.hasSegment && "sr-only"]}>{t("ficha.segmento.rotulo")}</dt>
              <dd class:list={["text-body", card.hasSegment ? "text-ink-900" : "text-ink-600"]} data-field="segment">
                {card.segmentLabel}
                {segment && <SegmentSource segment={segment} n={segmentMark?.n} />}
                {segment?.note && <p class="text-small text-ink-600" data-note="segment">{segment.note}</p>}
              </dd>
            </div>
          </dl>
          <a
            href={brandUrl}
            rel="noopener"
            data-web-marca
            class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
            >{t("ficha.webMarca")}<span class="sr-only"> {t("ficha.webMarcaSr", { marca: card.brand })}</span></a
          >
          {
            card.compare && (
              <p>
                <a
                  href={card.compare.href}
                  data-compare
                  class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
                >{card.compare.label}<span class="sr-only"> {card.compare.srLabel}</span></a>
              </p>
            )
          }
      </div>
      <section id="cifras" aria-label={t("ficha.cifras")} data-cifras class={`${inner} hero-cifras`}>
        <dl class="grid grid-cols-2 gap-x-6 gap-y-6 lg:grid-cols-4">
          <Cifra
            size="xl"
            class="border-t border-line-soft pt-3"
            figure="price"
            label={priceFrom?.price_kind === "financed" ? t("ficha.cifras.precioOferta") : t("ficha.cifras.precio")}
            text={priceFrom ? formatEur(priceFrom.value) : null}
          >
            {priceFrom && <SourceDate slot="detalle" source={priceFrom} />}
          </Cifra>
          {keyFigures.map((f) => (
            <Cifra size="xl" class="border-t border-line-soft pt-3" figure={f.id} label={f.label} text={f.text}>
              {f.datum && <SourceMark slot="marca" {...markOf(f.datum)} />}
            </Cifra>
          ))}
        </dl>
      </section>
      <CifrasCountUp />
      </div>
      {/* The photo (or the silhouette) comes after the text in the DOM and is painted behind it; the caption is the
          last item of the first screen. The figure adds no box of its own (display: contents). */}
      {
        mainSrc && mainImage ? (
          <figure class="hero-figure" data-main-image>
            <ScreenPhoto
              src={mainSrc}
              alt={altOf(1)}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1440px) 1440px, 100vw"
              width={1280}
              height={720}
              loading="eager"
              fetchpriority="high"
            />
            {captionOf(mainImage) && <figcaption class={`${inner} hero-credit`}>{captionOf(mainImage)}</figcaption>}
          </figure>
        ) : (
          <div class="hero-silhouette" data-slot="silhouette" data-main-image>
            <SegmentSilhouette segment={card.segment} large />
          </div>
        )
      }
      </div>
      </header>

      <section aria-labelledby="versiones-titulo" class:list={["band-section", band("versiones")]} data-ficha-versiones>
        <h2 id="versiones-titulo" class="text-section text-ink-900">{t("ficha.versiones.titulo")}</h2>
        {
          versions.length === 0 ? (
            <p class="mt-3 text-body text-ink-900" data-versiones-vacio>
              {t("ficha.versiones.vacio", { marca: card.brand })}
            </p>
          ) : (
            <>
              <p class="mt-1 text-small text-ink-600">{t("ficha.versiones.entrada")}</p>

              {/* One block per version at every width (RF-3), same order as the sorted list. No ids. */}
              <ol class="mt-4 border-t-4 border-ink-900" data-versiones-bloques>
                {versions.map((version) => (
                  <VersionBlock version={version} discontinued={discontinued} termsIndex={termsIndex(version)} numberOf={numberOf} />
                ))}
              </ol>

              {/* Offer terms: once, outside the table and the blocks, always visible (CA-4). Ids live here. */}
              {
                financed.length > 0 && (
                  <div class="mt-8" data-condiciones>
                    <h3 class="text-card-title text-ink-900">{t("ficha.condiciones.titulo")}</h3>
                    <ul class="mt-3 flex flex-col gap-6">
                      {financed.map((version, i) => (
                        <li id={`condiciones-${i + 1}`} tabindex="-1" class="max-w-prose">
                          <p class="text-body font-semibold text-ink-900 [overflow-wrap:anywhere]">{version.name}</p>
                          <div class="mt-1 flex flex-col gap-2 text-small text-ink-900 [overflow-wrap:anywhere]">
                            {paragraphs(version.price!.price_terms ?? "").map((p) => (
                              <p class="whitespace-pre-line">{p}</p>
                            ))}
                          </div>
                          <a
                            href={version.price!.price_terms_url}
                            rel="noopener"
                            class="mt-1 inline-flex min-h-touch items-center text-small text-brand-600 underline hover:text-brand-800"
                            >{t("ficha.condiciones.enlace")}</a
                          >
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
            </>
          )
        }
      </section>


      {modelRows.length > 0 && <ModelData rows={modelRows.map((r) => ({ ...r, mark: markOf(r.datum) }))} band={band("datos")} />}

      <MoreImages items={rest.map((image, i) => ({ image, alt: altOf(i + 2), caption: captionOf(image) }))} band={band("imagenes")} />

      <SegmentRelated related={related} hasSegment={card.hasSegment} segmentLabel={card.segmentLabel} band={band("relacionados")} />

      {notes.length > 0 && <SourcesBlock notes={notes} band={band("fuentes")} />}

      {hasReviews && <ReviewsStrip reviews={reviews} testResults={testResults} brand={card.brand} model={card.model} versionNames={versions.map((v) => v.name)} band={band("reviews")} />}
    </main>
    <SectionMenu label={t("ficha.menu.nombre")} items={menuItems} />
  </body>
</html>

<style is:global>
  /* Full-width bands whose content keeps the page width and gutters (max-w-page, px-4/6/8). */
  .band-section {
    --gutter: 1rem;
    padding-block: 3.5rem;
    padding-inline: max(var(--gutter), calc((100% - var(--container-page)) / 2 + var(--gutter)));
  }
  @media (min-width: 768px) {
    .band-section { --gutter: 1.5rem; }
  }
  @media (min-width: 1024px) {
    .band-section { --gutter: 2rem; }
  }

  /* First screen: dark band, photo or silhouette behind the text, the text on the solid part of the scrim. */
  .hero-screen {
    --scrim-rgb: 11 18 23; /* ink-950, the dark band */
    --scrim:
      linear-gradient(to bottom, rgb(var(--scrim-rgb) / 0.78) 0, transparent 9rem),
      linear-gradient(to bottom, transparent 30%, rgb(var(--scrim-rgb) / 0.72) 64%, rgb(var(--scrim-rgb) / 1) 100%);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    isolation: isolate;
    min-height: calc(100svh - var(--menu-clearance));
    overflow: hidden;
    position: relative;
  }
  .hero-top,
  .hero-foot,
  .hero-credit {
    position: relative;
    width: 100%;
    z-index: 1; /* above the photo, which comes later in the DOM */
  }
  .hero-top {
    padding-top: 0.5rem;
  }
  .hero-foot {
    padding-top: 7rem;
  }
  .hero-cifras {
    margin-top: 2rem;
    padding-bottom: 1.5rem;
  }
  .hero-figure {
    display: contents;
  }
  .hero-credit {
    color: var(--color-on-dark-muted);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    overflow-wrap: anywhere;
    padding-bottom: 1rem;
  }
  .hero-name {
    font-size: var(--text-display);
    font-stretch: var(--font-stretch-wide);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 0.98;
  }
  .hero-brand {
    display: block;
    font-size: var(--text-body);
    font-stretch: 100%;
    font-weight: 600;
    letter-spacing: 0;
    line-height: var(--text-body--line-height);
    margin-bottom: 0.25rem;
  }
  .hero-model {
    display: block;
  }
  /* Names break between words, never inside one; a word too long still fits. */
  .hero-word {
    display: inline-block;
    max-width: 100%;
    overflow-wrap: anywhere;
  }
  .hero-silhouette {
    --size-segment-icon-lg: 24rem;
    align-items: center;
    color: var(--color-on-dark-muted);
    display: flex;
    inset: 0;
    justify-content: center;
    pointer-events: none;
    position: absolute;
    z-index: 0;
  }
  .hero-silhouette svg {
    stroke-width: 0.3;
  }
  @media (min-width: 1024px) {
    .hero-silhouette {
      --size-segment-icon-lg: 42rem;
    }
  }
</style>
