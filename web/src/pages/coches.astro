---
import "../styles/global.css";
import ModelCard from "../components/ModelCard.astro";
import { cardView } from "../lib/card.ts";
import { loadModels } from "../lib/data.ts";
import { t } from "../lib/i18n.ts";

const { models } = loadModels();
const cards = models.map(cardView);

const title = t("pagina.coches.titulo");
const site = t("sitio.nombre");
const documentTitle = site ? t("pagina.tituloDocumento", { titulo: title, sitio: site }) : title;
const count =
  models.length === 0 ? t("resumen.cero") : models.length === 1 ? t("resumen.uno") : t("resumen.n", { n: models.length });
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
  </head>
  <body>
    <a
      href="#resultados"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:bg-surface focus:p-2 focus:text-brand-600 focus:underline"
      >{t("pagina.saltar")}</a
    >
    <main class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8">
      <h1 class="text-title [overflow-wrap:anywhere]">{title}</h1>
      <p class="mt-2 max-w-prose text-body text-ink-900">{t("pagina.coches.entrada")}</p>
      <p class="mt-3 text-body text-ink-600" data-count>{count}</p>

      <section class="mt-8" aria-labelledby="resultados">
        <h2 id="resultados" tabindex="-1" class="text-section">{t("resultados.titulo")}</h2>
        {
          cards.length > 0 ? (
            <ul
              aria-labelledby="resultados"
              class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6 lg:grid-cols-3"
            >
              {cards.map((card) => (
                <ModelCard card={card} href={`/marcas/${card.key}/`} />
              ))}
            </ul>
          ) : (
            <p class="mt-4 text-body text-ink-900">{t("vacio.catalogo.texto")}</p>
          )
        }
      </section>
    </main>
  </body>
</html>
