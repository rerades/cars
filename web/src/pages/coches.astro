---
import CatalogPage from "../components/CatalogPage.astro";
import { cardView } from "../lib/card.ts";
import { countLabel, exploreGroups } from "../lib/catalog.ts";
import { loadModels } from "../lib/data.ts";
import { summarize } from "../lib/derived.ts";
import { factAttrs } from "../lib/filter.ts";
import { filterPanelView } from "../lib/filter-view.ts";
import { t } from "../lib/i18n.ts";

const { models } = loadModels();
---

<CatalogPage
  title={t("pagina.coches.titulo")}
  intro={t("pagina.coches.entrada")}
  count={countLabel(models.length)}
  cards={models.map(cardView)}
  emptyText={t("vacio.catalogo.texto")}
  explore={exploreGroups(models, "/coches/")}
  currentHref="/coches/"
  filters={{
    view: filterPanelView(models),
    facts: models.map((m) => factAttrs(summarize(m))),
  }}
/>
