---
import "../styles/global.css";
import ComparisonTable from "../components/ComparisonTable.astro";
import { t } from "../lib/i18n.ts";

// Static shell of /comparar/ (PRD-003, RF-14, RNF-6). The script of ComparisonTable removes the
// no-JS notice and mounts the table; there is no table in the served HTML, only in <template>.
const title = t("comparador.titulo");
const site = t("sitio.nombre");
const documentTitle = site ? t("pagina.tituloDocumento", { titulo: title, sitio: site }) : title;
// Fixed canonical, never with a query string, whatever the selection (CA-16).
const canonical = new URL("/comparar/", Astro.site).href;

const messages = {
  loading: t("comparador.cargando"),
  error: t("comparador.error"),
  noJsLink: t("comparador.sinJs.enlace"),
};
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <main class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8" data-messages={JSON.stringify(messages)}>
      <h1 class="text-title [overflow-wrap:anywhere]">{title}</h1>
      <p class="mt-2 max-w-prose text-body text-ink-600">{t("comparador.entrada")}</p>

      <div
        class="mt-4 max-w-prose rounded-card border border-line bg-surface-muted p-4 text-body text-ink-900"
        data-no-js
      >
        <p><span class="font-semibold">{t("comparador.aviso.prefijo")}</span> {t("comparador.sinJs.texto")}</p>
        <a
          href="/coches"
          class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
        >{t("comparador.sinJs.enlace")}</a>
      </div>

      <!-- Loading and error states (RNF-6); the script unhides them. Not in the page without JS. -->
      <p role="status" class="mt-4 max-w-prose text-body text-ink-900" data-loading hidden>{messages.loading}</p>
      <div class="mt-4 max-w-prose text-body text-ink-900" data-error hidden>
        <p>{messages.error}</p>
        <a
          href="/coches"
          class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
        >{messages.noJsLink}</a>
      </div>

      <!-- URL notice (RF-11): paragraphs filled by the script; not a live region. -->
      <div
        class="mt-4 flex max-w-prose flex-col gap-2 rounded-card border border-line bg-surface-muted p-4 text-body text-ink-900"
        data-url-notice
        hidden
      >
        <p data-notice-p hidden>
          <span class="font-semibold">{t("comparador.aviso.prefijo")}</span> <span data-notice-text></span>
        </p>
      </div>

      <!-- «Coches comparados» (RF-12); the version and «Quitar» (#321) and «Añadir» (#322) come later. -->
      <section aria-labelledby="cmp-elegidos" class="mt-8" data-chosen hidden>
        <h2 id="cmp-elegidos" class="text-section">{t("comparador.elegidos.titulo")}</h2>
        <ol class="mt-4 flex flex-col gap-2" data-chosen-list></ol>
        <p class="mt-4 max-w-prose text-body text-ink-900" data-empty-text hidden></p>
        <a
          href="/coches"
          class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
          data-empty-link
          hidden>{t("comparador.vacio.catalogo")}</a
        >
      </section>
      <ComparisonTable />

      <div role="status" aria-live="polite" class="sr-only" data-status></div>
    </main>
  </body>
</html>
