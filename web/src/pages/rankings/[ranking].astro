---
import "../../styles/global.css";
import { t, type MessageKey } from "../../lib/i18n.ts";
import { loadModels } from "../../lib/data.ts";
import { RANKINGS, type RankingDef } from "../../lib/rankings.ts";
import { filterOptions, leftOutView, placeViews } from "../../lib/ranking-view.ts";
import { summaryKey } from "../../lib/ranking-state.ts";
import RankingFilters from "../../components/RankingFilters.astro";
import RankingPlace from "../../components/RankingPlace.astro";
import RankingTerms from "../../components/RankingTerms.astro";

export function getStaticPaths() {
  // The URL is `/rankings/<slug>`; the slug is the last segment of the table's `url`.
  return RANKINGS.map((ranking) => ({
    params: { ranking: ranking.url.split("/").pop()! },
    props: { ranking },
  }));
}

const { ranking } = Astro.props as { ranking: RankingDef };
const { models } = loadModels();
const places = placeViews(models, ranking);
const options = filterOptions(models, ranking);
const leftOut = leftOutView(models, ranking);
const deals = places.flatMap((p) => (p.deal ? [p.deal] : []));
const isPrice = ranking.id === "precio";
const key = (suffix: string) => `${ranking.textKey}.${suffix}` as MessageKey;
const title = t(key("titulo"));
// Served with a trailing slash like the other pages; never with a query string (RF-13).
const canonical = new URL(`${ranking.url}/`, Astro.site).href;
const site = t("sitio.nombre");
const documentTitle = site ? t("pagina.tituloDocumento", { titulo: title, sitio: site }) : title;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{documentTitle}</title>
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a
      href="#resultados"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-2 focus:bg-surface focus:p-2 focus:text-brand-600 focus:underline"
      >{t("pagina.saltar")}</a
    >
    <main class="mx-auto max-w-page px-4 py-8 md:px-6 lg:px-8">
      <nav aria-label={t("ficha.ruta.nombre")} data-ranking-ruta>
        <ol class="flex flex-wrap items-center text-small">
          <li class="flex items-center after:mx-2 after:text-ink-600 after:[content:'›'/'']">
            <a
              href="/coches"
              class="inline-flex min-h-touch items-center text-brand-600 underline hover:text-brand-800"
              >{t("ficha.ruta.coches")}</a
            >
          </li>
          <li aria-current="page" class="text-ink-600 [overflow-wrap:anywhere]">{title}</li>
        </ol>
      </nav>
      <header data-ranking-header>
        <h1 class="text-title text-ink-900 [overflow-wrap:anywhere]">{title}</h1>
        <p class="mt-2 max-w-prose text-body text-ink-900" data-intro>{t(key("entrada"))}</p>
        <p class="mt-2 max-w-prose text-body font-semibold text-ink-900" data-order>{t(key("orden"))}</p>
        <p class="mt-2 max-w-prose text-small text-ink-600" data-scope>{t("ranking.alcance")}</p>
      </header>
      {places.length > 0 && <RankingFilters ranking={ranking} segments={options.segments} prices={options.prices} />}
      <section aria-labelledby="resultados" class="mt-8">
        <h2 id="resultados" tabindex="-1" class="text-section">{t("ranking.lista.titulo")}</h2>
        {
          places.length === 0 && (
            <div class="mt-4 max-w-prose" data-ranking-empty>
              <p class="text-body font-semibold text-ink-900">{t("ranking.vacio.titulo")}</p>
              <p class="text-body text-ink-900">
                {t("ranking.vacio.texto", { dato: t(key("dato")) })}
              </p>
              <a
                href="/coches"
                class="inline-flex min-h-touch items-center text-body text-brand-600 underline hover:text-brand-800"
                >{t("vacio.pagina.enlace")}</a
              >
            </div>
          )
        }
        {
          places.length > 0 && (
            <p class="mt-2 text-body text-ink-600" data-ranking-summary>
              {t(summaryKey(places.length), { n: places.length })}
            </p>
          )
        }
        {places.length > 0 && <ol
          role="list"
          aria-labelledby="resultados"
          class="mt-4 max-w-(--width-ranking) list-none p-0"
          data-ranking-list
        >
          {
            places.map((p) => <RankingPlace place={p} />)
          }
        </ol>}
      </section>
      {
        places.length > 0 && (
          <template data-place-template>
            <RankingPlace place={null} />
          </template>
        )
      }
      <p class="mt-4 max-w-prose text-small text-ink-600" data-left-out>{leftOut.text}</p>
      {
        deals.length > 0 && (
          <section aria-labelledby="condiciones" class="mt-8" data-condiciones>
            <h2 id="condiciones" class="text-section">{t("ficha.condiciones.titulo")}</h2>
            <ul class="mt-3 flex flex-col gap-6">
              {deals.map((deal) => <RankingTerms deal={deal} />)}
            </ul>
          </section>
        )
      }
      {
        isPrice && (
          <template data-terms-template>
            <RankingTerms deal={null} />
          </template>
        )
      }
      {
        isPrice && (
          <template data-terms-section-template>
            <section aria-labelledby="condiciones" class="mt-8">
              <h2 id="condiciones" class="text-section">{t("ficha.condiciones.titulo")}</h2>
              <ul class="mt-3 flex flex-col gap-6" />
            </section>
          </template>
        )
      }
    </main>
  </body>
</html>
