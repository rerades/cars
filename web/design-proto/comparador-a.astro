---
// The comparator (PRD-003) in the chosen direction (docs/design/direccion.md, "La elegida"). Spec:
// docs/design/comparador.md, "Dirección visual". Static: the page's script would build this from the
// JSON of ADR-0014; here the same pure functions of lib/compare.ts render it on the server.
// Below 768 px the page is drawn 320 px wide inside the 390 px capture, to check RNF-1 / CA-17 at 320.
import "../src/styles/global.css";
import { loadModels } from "../src/lib/data.ts";
import {
  FIELDS, cellView, conditionTitle, defaultVersion, fieldLabel, headerView, isComparable, noticeParagraphs,
  numberNotes, projectModel, sheetOrder, type FieldId,
} from "../src/lib/compare.ts";
import { t } from "../src/lib/i18n.ts";
import { noteLine } from "../src/lib/notes.ts";

// Hard cases from data/raw: an offer price (R5), a very long version name (Polestar 3), an announced model.
const PICK = [
  { file: "renault/r5-e-tech-electrico.yaml", name: null },
  { file: "polestar/polestar-3.yaml", name: "Long Range Dual Motor MY2025 km0 (Pilot Pack y Plus Pack)" },
  { file: "mercedes-benz/gla.yaml", name: null },
];
const all = loadModels().models;
const columns = PICK.map(({ file, name }) => {
  const rec = all.find((m) => m.file === file)!;
  const [brand, slugFile] = file.split("/");
  const model = projectModel(rec, slugFile!.replace(/\.yaml$/, ""));
  const version = model.versions.find((v) => v.name === name) ?? defaultVersion(model.versions)!;
  return { model, version, comparable: isComparable(rec), brand };
});
const { notes, columns: marks } = numberNotes(columns);
const notice = noticeParagraphs({ ignored: 1, tooMany: false } as never);
const financed = columns.map((c, i) => ({ ...c, n: i + 1 })).filter((c) => c.version.price?.price_kind === "financed");
const FIGURE_ROWS: FieldId[] = ["precio", "autonomia"];
const split = (text: string) => {
  const parts = text.split(/\s+/);
  const unit = parts.length > 1 ? parts.pop() : null;
  return { number: parts.join(" "), unit };
};
const mark = (n: number | undefined, unofficial: boolean) =>
  n ? { n, label: t("ficha.nota.marca", { n }), sr: t("ficha.nota.sr", { n }), unofficial } : null;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{t("pagina.tituloDocumento", { titulo: t("comparador.titulo"), sitio: t("sitio.nombre") })}</title>
  </head>
  <body class="proto-frame">
    <main>
      {/* 1. Dark band: title, intro and the URL notice (RF-11). No photo: PRD-003 sección 6 publishes no images. */}
      <section class="band-dark cmp-top">
        <div class="cmp-wrap">
          <a href="/" class="cmp-wordmark">{t("sitio.nombre")}</a>
          <h1 class="cmp-h1">{t("comparador.titulo")}</h1>
          <p class="cmp-intro">{t("comparador.entrada")}</p>
          <div class="cmp-notice">
            {notice.map((p, i) => <p>{i === 0 && <strong>{t("comparador.aviso.prefijo")} </strong>}{p}</p>)}
          </div>
        </div>
      </section>

      {/* 2. Light band: the chosen columns and their controls (RF-8, RF-9). */}
      <section class="band-light cmp-block" aria-labelledby="cmp-elegidos">
        <div class="cmp-wrap">
          <h2 id="cmp-elegidos" class="cmp-h2">{t("comparador.elegidos.titulo")}</h2>
          <ol class="cmp-chosen">
            {columns.map(({ model, version }, i) => {
              const options = sheetOrder(model.versions);
              return (
                <li>
                  <span class="cmp-chosen-name">{model.brand_name} {model.model}</span>
                  {options.length > 1 ? (
                    <div class="cmp-field">
                      <label for={`cmp-v-${i}`}>{t("comparador.version.rotulo")}</label>
                      <select id={`cmp-v-${i}`} aria-label={t("comparador.version.sr", { marca: model.brand_name, modelo: model.model, n: i + 1 })}>
                        {options.map((o) => (
                          <option selected={o.name === version.name}>{o.name}</option>
                        ))}
                      </select>
                    </div>
                  ) : (
                    <p class="cmp-single">{t("comparador.version.unica", { nombre: version.name })}</p>
                  )}
                  <button type="button" class="cmp-btn">
                    {t("comparador.quitar")}
                    <span class="sr-only"> {t("comparador.quitarSr", { marca: model.brand_name, modelo: model.model, nombre: version.name })}</span>
                  </button>
                </li>
              );
            })}
          </ol>
          <p class="cmp-max">{t("comparador.maximo")}</p>
        </div>
      </section>

      {/* 3. White band: the table. Header row is a dark strip; price and range use Cifra's type. */}
      <section class="band-white cmp-block" aria-labelledby="cmp-tabla">
        <div class="cmp-wrap">
          <h2 id="cmp-tabla" class="cmp-h2">{t("comparador.tabla.titulo")}</h2>
          <p class="cmp-intro">{t("comparador.tabla.entrada")}</p>
          <table class="cmp-table">
            <caption class="sr-only">{t("comparador.tabla.caption", { n: columns.length })}</caption>
            <thead class="band-dark">
              <tr>
                {columns.map(({ model, version }, i) => {
                  const h = headerView(model, version);
                  return (
                    <th scope="col" id={`cmp-col-${i + 1}`}>
                      <a href={h.href} class="cmp-head-link">
                        <span class="cmp-head-brand">{h.brand}</span>
                        <span class="cmp-head-model">{h.model}</span>
                        <span class="sr-only"> {h.srSuffix}</span>
                      </a>
                      <span class="cmp-head-version">{h.name}</span>
                      {h.badge && (
                        <span class="cmp-head-badge">
                          <span class="cmp-badge cmp-badge--soon">{h.badge}</span>
                          {marks[i]!.header.map((n) => (
                            <a href={`#cmp-fuente-${n}`} class="cmp-mark"><span aria-hidden="true">{t("ficha.nota.marca", { n })}</span><span class="sr-only">{t("ficha.nota.sr", { n })}</span></a>
                          ))}
                        </span>
                      )}
                    </th>
                  );
                })}
              </tr>
            </thead>
            {FIELDS.map((field) => (
              <tbody>
                <tr>
                  <th colspan={columns.length} id={`cmp-f-${field}`} class="cmp-row-label">{fieldLabel(field)}</th>
                </tr>
                <tr>
                  {columns.map(({ version }, i) => {
                    const c = cellView(field, version);
                    const m = mark(marks[i]!.cells[field], c.unofficial);
                    const fig = FIGURE_ROWS.includes(field);
                    const parts = split(c.text);
                    return (
                      <td headers={`cmp-col-${i + 1} cmp-f-${field}`}>
                        {fig ? (
                          c.missing ? (
                            <span class="cmp-fig-missing">{c.text}</span>
                          ) : (
                            <span class="cmp-fig">
                              <span class="cifra__valor">{parts.number}</span>
                              {parts.unit && <> <span class="cifra__unidad">{parts.unit}</span></>}
                            </span>
                          )
                        ) : (
                          <span class:list={["cmp-value", c.missing && "is-missing"]}>{c.text}</span>
                        )}
                        {m && (
                          <span class="cmp-markline">
                            <a href={`#cmp-fuente-${m.n}`} class="cmp-mark"><span aria-hidden="true">{m.label}</span><span class="sr-only">{m.sr}</span></a>
                            {m.unofficial && <span class="cmp-small"> {t("ficha.nota.noOficial")}</span>}
                          </span>
                        )}
                        {c.deal && <span class="cmp-badge cmp-badge--deal">{c.deal}</span>}
                        {c.source && (
                          <span class="cmp-small cmp-source">
                            {t("ficha.precio.fuente", { fuente: "§", fecha: c.source.date }).split("§")[0]}
                            <a href={c.source.url}>{c.source.name}</a>
                            {t("ficha.precio.fuente", { fuente: "§", fecha: c.source.date }).split("§")[1]}
                            {c.unofficial && <> · {t("ficha.nota.noOficial")}</>}
                          </span>
                        )}
                        {c.terms && <a href={`#cmp-condiciones-${i + 1}`} class="cmp-small cmp-link">{t("ficha.precio.verCondiciones")}</a>}
                        {c.note && <span class="cmp-small cmp-note">{c.note}</span>}
                      </td>
                    );
                  })}
                </tr>
              </tbody>
            ))}
          </table>

          {financed.length > 0 && (
            <div class="cmp-terms">
              <h3 class="cmp-h3">{t("ficha.condiciones.titulo")}</h3>
              {financed.map(({ model, version, n }) => (
                <div id={`cmp-condiciones-${n}`} tabindex="-1" class="cmp-terms-item">
                  <p class="cmp-terms-name">{conditionTitle(model, version)}</p>
                  <p class="cmp-small">{version.price!.price_terms}</p>
                  {version.price!.price_terms_url && <a href={version.price!.price_terms_url} class="cmp-small cmp-link">{t("ficha.condiciones.enlace")}</a>}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>

      {/* 4. Light band: sources (RF-4). */}
      <section class="band-light cmp-block" aria-labelledby="cmp-fuentes">
        <div class="cmp-wrap">
          <h2 id="cmp-fuentes" class="cmp-h2">{t("ficha.fuentes.titulo")}</h2>
          <p class="cmp-intro">{t("ficha.fuentes.entrada")}</p>
          <ol class="cmp-sources">
            {notes.map((note) => (
              <li id={`cmp-fuente-${note.n}`} tabindex="-1">{noteLine(note)} <a href={note.url}>{note.url}</a></li>
            ))}
          </ol>
        </div>
      </section>
    </main>
  </body>
</html>

<style is:global>
  /* Prototype only: draws the page 320 px wide inside the 390 px capture. */
  @media (max-width: 767px) {
    .proto-frame { background: #6b7280; }
    .proto-frame > main { margin-inline: auto; max-width: 320px; }
  }

  .cmp-wrap { margin-inline: auto; max-width: var(--container-page); padding-inline: 1rem; }
  @media (min-width: 768px) { .cmp-wrap { padding-inline: 2.5rem; } }

  .cmp-top { padding-block: 0.5rem 2.5rem; }
  .cmp-block { padding-block: 2.5rem; }
  @media (min-width: 1024px) { .cmp-top { padding-bottom: 3.5rem; } .cmp-block { padding-block: 3.5rem; } }

  .cmp-wordmark {
    align-items: center; display: inline-flex; min-height: var(--spacing-touch);
    font-size: 1.125rem; font-stretch: var(--font-stretch-wide); font-weight: 800; letter-spacing: -0.02em;
  }
  .cmp-h1, .cmp-h2 {
    font-stretch: var(--font-stretch-wide); font-weight: 800; letter-spacing: -0.035em; line-height: 1;
    overflow-wrap: anywhere;
  }
  .cmp-h1 { font-size: var(--text-display); margin-top: 1.5rem; }
  .cmp-h2 { font-size: var(--text-block); }
  .cmp-h3 { font-size: var(--text-version); font-stretch: var(--font-stretch-wide); font-weight: 800; letter-spacing: -0.035em; }
  .cmp-intro { color: var(--color-ink-600); font-size: var(--text-small); line-height: var(--text-small--line-height); margin-top: 0.75rem; max-width: var(--container-prose); }
  .cmp-top .cmp-intro { font-size: var(--text-body); line-height: var(--text-body--line-height); }

  .cmp-notice {
    border: 1px solid var(--color-ink-600); border-radius: var(--radius-card); display: grid; gap: 0.5rem;
    margin-top: 1.5rem; max-width: var(--container-prose); padding: 1rem;
  }
  .cmp-notice strong { font-weight: 600; }

  /* Chosen columns: the column number in the narrow figure type. */
  .cmp-chosen { border-top: 2px solid var(--color-ink-900); counter-reset: col; margin-top: 1.5rem; }
  .cmp-chosen > li {
    border-bottom: 1px solid var(--color-line-soft); counter-increment: col; display: grid; gap: 0.5rem 1rem;
    grid-template-columns: 2.25rem minmax(0, 1fr); padding-block: 1rem;
  }
  .cmp-chosen > li::before {
    content: counter(col) / ""; font-size: 2.75rem; font-stretch: var(--font-stretch-narrow); font-weight: 700;
    grid-row: span 3; line-height: 0.82;
  }
  .cmp-chosen-name { font-size: var(--text-body); font-weight: 700; overflow-wrap: anywhere; }
  .cmp-field { display: grid; gap: 0.25rem; }
  .cmp-field label { font-size: var(--text-small); font-weight: 600; }
  .cmp-field select {
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-pill);
    color: var(--color-ink-900); font: inherit; max-width: var(--width-version-col-max); min-height: var(--spacing-touch);
    min-width: 0; padding-inline: 1rem; width: 100%;
  }
  .cmp-btn {
    background: var(--color-surface); border: 1px solid var(--color-line); border-radius: var(--radius-pill);
    color: var(--color-ink-900); font: inherit; font-weight: 600; justify-self: start; min-height: var(--spacing-touch); padding-inline: 1.25rem;
  }
  .cmp-btn:hover { border-color: var(--color-ink-900); }
  .cmp-max { margin-top: 1rem; }
  @media (min-width: 768px) {
    .cmp-chosen > li { align-items: center; grid-template-columns: 3rem minmax(10rem, 1fr) minmax(0, 20rem) auto; }
    .cmp-chosen > li::before { grid-row: auto; font-size: 3.25rem; }
    .cmp-field { align-items: center; grid-template-columns: auto minmax(0, 1fr); gap: 0.75rem; }
  }

  /* The table: equal columns (RF-13), hairlines, no fills that depend on the value. */
  .cmp-table {
    border-collapse: collapse; margin-top: 1.5rem; max-width: calc(3 * var(--width-version-col-max)); table-layout: fixed; width: 100%;
  }
  .cmp-table :is(th, td) { padding: 0.5rem; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
  .cmp-table thead th + th, .cmp-table td + td { border-left: 1px solid var(--color-line-soft); }
  .cmp-table thead th { padding-block: 0.75rem 1rem; }
  @media (min-width: 768px) { .cmp-table :is(th, td) { padding: 0.75rem 1rem; } .cmp-table thead th { padding-block: 1.25rem 1.5rem; } }

  .cmp-head-link { display: block; min-height: var(--spacing-touch); text-decoration: underline; text-underline-offset: 0.15em; }
  .cmp-head-link:hover { color: var(--color-brand-800); }
  .cmp-head-brand { color: var(--color-ink-600); display: block; font-size: var(--text-small); font-weight: 600; line-height: var(--text-small--line-height); }
  .cmp-head-model { display: block; font-size: var(--text-body); font-weight: 800; line-height: 1.15; margin-top: 0.125rem; }
  .cmp-head-version { display: block; font-size: var(--text-small); font-weight: 600; line-height: var(--text-small--line-height); margin-top: 0.5rem; }
  .cmp-head-badge { display: block; margin-top: 0.5rem; }
  @media (min-width: 768px) {
    .cmp-head-model { font-size: var(--text-version); font-stretch: var(--font-stretch-wide); letter-spacing: -0.035em; line-height: 1.05; }
  }

  .cmp-row-label {
    border-top: 1px solid var(--color-line-soft); color: var(--color-ink-600); font-size: var(--text-small);
    font-weight: 600; line-height: var(--text-small--line-height); padding-bottom: 0 !important;
  }
  .cmp-table tbody:first-of-type .cmp-row-label { border-top: 0; }
  .cmp-table td { padding-bottom: 1rem; }

  /* Number and unit side by side; the unit drops below only when the column is too narrow. */
  .cmp-fig { align-items: baseline; column-gap: 0.12em; display: flex; flex-wrap: wrap; font-size: var(--text-figure-s); line-height: 0.82; overflow-wrap: normal; }
  .cmp-fig .cifra__unidad { line-height: 1.2; }
  .cmp-table th { hyphens: auto; }
  .cmp-fig .cifra__valor { letter-spacing: -0.015em; }
  .cmp-fig-missing {
    color: var(--color-ink-600); display: block; font-size: max(calc(var(--text-figure-s) * 0.46), var(--text-small));
    font-stretch: var(--font-stretch-narrow); font-weight: 700; line-height: 1.1;
  }
  .cmp-value { display: block; }
  .cmp-value.is-missing { color: var(--color-ink-600); }
  .cmp-small { color: var(--color-ink-600); display: block; font-size: var(--text-small); line-height: var(--text-small--line-height); margin-top: 0.375rem; }
  .cmp-markline { display: block; }
  .cmp-markline .cmp-small { display: inline; }
  .cmp-mark { color: var(--color-brand-600); display: inline-block; font-size: var(--text-small); min-height: 1.5rem; min-width: 1.5rem; text-decoration: underline; }
  .cmp-source a, .cmp-link, .cmp-sources a { color: var(--color-brand-600); text-decoration: underline; }
  .cmp-link { align-items: center; display: inline-flex; min-height: var(--spacing-touch); }
  .cmp-badge {
    border-radius: var(--radius-card); display: inline-block; font-size: var(--text-badge); font-weight: 600;
    line-height: var(--text-badge--line-height); margin-top: 0.5rem; padding: 0.125rem 0.5rem;
  }
  .cmp-badge--soon { background: var(--color-soon-bg); color: var(--color-soon-fg); margin-top: 0; }
  .cmp-badge--deal { background: var(--color-deal-bg); color: var(--color-deal-fg); }

  .cmp-terms { border-top: 2px solid var(--color-ink-900); margin-top: 2.5rem; padding-top: 1.5rem; }
  .cmp-terms-item { margin-top: 1rem; max-width: var(--container-prose); }
  .cmp-terms-name { font-weight: 700; overflow-wrap: anywhere; }
  .cmp-sources { display: grid; font-size: var(--text-small); gap: 0.5rem; line-height: var(--text-small--line-height); list-style: decimal inside; margin-top: 1.5rem; overflow-wrap: anywhere; }

  :root { --text-figure-s: clamp(2rem, 3.2vw, 3rem); }
</style>
