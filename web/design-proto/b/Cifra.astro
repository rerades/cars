---
/**
 * Key figure of proposal B (docs/design/propuesta-b.md, RF-18). `text` is the already formatted value
 * ("446 km", "32.800 €"), or null for «por confirmar». Lives in a subfolder so it is not a /proto/ route.
 */
import { t } from "../../src/lib/i18n.ts";

interface Props {
  label: string;
  text: string | null;
  size: "xl" | "l" | "m" | "s";
}
const { label, text, size } = Astro.props;
// The unit goes smaller and wider than the number; the space (normal or no-break) separates them.
const parts = text?.split(/[\s ]/) ?? [];
const unit = parts.length > 1 ? parts.pop() : null;
const number = parts.join(" ");
---

<div class={`cifra cifra--${size}`}>
  <dt>{label}<slot name="marca" /></dt>
  <dd>
    {
      text ? (
        <span class="cifra__valor">
          {number}
          {unit && <span class="cifra__unidad"> {unit}</span>}
        </span>
      ) : (
        <span class="cifra__falta">
          {t("ficha.porConfirmar").split(" ").map((w) => <span>{w} </span>)}
        </span>
      )
    }
  </dd>
  {Astro.slots.has("detalle") && <dd class="cifra__detalle"><slot name="detalle" /></dd>}
</div>
