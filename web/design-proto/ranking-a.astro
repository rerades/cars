---
/**
 * Ranking page in the chosen direction (docs/design/rankings.md, "Dirección visual"): dark header band,
 * light filter bar, the places as a dark "screen" list with the ranking figure as a Cifra, and a white
 * band for the left-out note and the offer terms. Real data, real texts; no new JavaScript.
 */
import "../src/styles/global.css";
import "./pantalla.css";
import Cifra from "./a/Cifra.astro";
import RankingTerms from "../src/components/RankingTerms.astro";
import { loadModels } from "../src/lib/data.ts";
import { rankingById, type RankingId } from "../src/lib/rankings.ts";
import { filterOptions, leftOutView, placeViews } from "../src/lib/ranking-view.ts";
import { summaryKey } from "../src/lib/ranking-state.ts";
import { t, type MessageKey } from "../src/lib/i18n.ts";

// The price ranking: the only one with offers, badges and terms, and the longest figures.
const RANKING: RankingId = "precio";
const ranking = rankingById(RANKING);
const { models } = loadModels();
const places = placeViews(models, ranking);
const options = filterOptions(models, ranking);
const leftOut = leftOutView(models, ranking);
const deals = places.flatMap((p) => (p.deal ? [p.deal] : []));
const key = (s: string) => `${ranking.textKey}.${s}` as MessageKey;
const title = t(key("titulo"));
const LABEL: Record<RankingId, MessageKey> = {
  precio: "ficha.campo.precio",
  autonomia: "ficha.campo.autonomia",
  bateria: "ficha.campo.bateria",
  potencia: "ficha.campo.potencia",
  cargaCc: "ficha.campo.cargaCc",
};
// Battery: "58 kWh, útil" → figure "58 kWh" and the basis goes to the label (spec, "La cifra").
const figureOf = (text: string) => {
  const [value, base] = text.split(/,\s(.+)/);
  return { value, label: base ? `${t(LABEL[RANKING])} · ${base}` : t(LABEL[RANKING]) };
};
const [before = "", between = "", after = ""] = t("ranking.fuente", { fuente: "\u0001", fecha: "\u0002" }).split(/[\u0001\u0002]/);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("pagina.tituloDocumento", { titulo: title, sitio: t("sitio.nombre") })}</title>
  </head>
  <body>
    <header class="band-dark">
      <div class="wrap rk-head">
        <a href="/" class="wordmark">{t("sitio.nombre")}</a>
        <nav aria-label={t("ficha.ruta.nombre")}>
          <ol class="rk-crumbs">
            <li><a href="/coches" class="rk-link">{t("ficha.ruta.coches")}</a></li>
            <li aria-current="page">{title}</li>
          </ol>
        </nav>
        <h1 class="rk-title wide">{title.split(" ").map((w) => <><span class="word">{w}</span>{" "}</>)}</h1>
        <p class="rk-intro">{t(key("entrada"))}</p>
        <p class="rk-order">{t(key("orden"))}</p>
        <p class="rk-scope">{t("ranking.alcance")}</p>
      </div>
    </header>

    <main>
      <div class="band-light">
        <div class="wrap rk-bar" role="group" aria-labelledby="filtrar">
          <h2 id="filtrar" class="sr-only">{t("ranking.filtros.titulo")}</h2>
          {options.segments.length > 0 && (
            <label class="rk-select">
              <span>{t("filtros.segmento")}</span>
              <select>
                <option>{t("ranking.filtros.todos")}</option>
                {options.segments.map((o) => <option>{o.label}</option>)}
              </select>
            </label>
          )}
          <label class="rk-select">
            <span>{t("filtros.precio")}</span>
            <select>
              <option>{t("ranking.filtros.cualquiera")}</option>
              {options.prices.map((o) => <option>{o.label}</option>)}
            </select>
          </label>
        </div>
      </div>

      <section class="band-dark" aria-labelledby="resultados">
        <div class="wrap rk-list-head">
          <h2 id="resultados" tabindex="-1" class="rk-h2 wide">{t("ranking.lista.titulo")}</h2>
          <p class="rk-summary" role="status">{t(summaryKey(places.length), { n: places.length })}</p>
        </div>
        <ol role="list" aria-labelledby="resultados" class="wrap rk-list">
          {
            places.map((p) => {
              const f = figureOf(p.figure);
              return (
                <li value={p.place} class="rk-place">
                  <h3 class="rk-h3">
                    <span class="rk-number">
                      <span class="sr-only">{t("ranking.puesto.sr")} </span>
                      <span class="rk-number__value">{p.place}</span>
                      {p.tied && <span class="rk-tie">{t("ranking.puesto.empate")}</span>}
                    </span>
                    <a href={p.href} class="rk-name">
                      <span class="rk-brand">{p.brand}</span>{" "}
                      <span class="rk-model wide">{p.model.split(" ").map((w) => <><span class="word">{w}</span>{" "}</>)}</span>
                    </a>
                  </h3>
                  <div class="rk-meta">
                    <p class="rk-version">{p.version}</p>
                    <p class:list={["rk-segment", !p.hasSegment && "is-missing"]}>
                      <span class="sr-only">{t("ranking.segmento.sr")} </span>{p.segment}
                    </p>
                  </div>
                  <dl class="rk-figure">
                    <Cifra size="l" label={f.label} text={f.value}>
                      <div slot="detalle" class="rk-detail">
                        {p.deal && (
                          <p><span class="inline-block rounded-full bg-deal-bg px-3 py-1 text-badge text-deal-fg">{t("ficha.precio.oferta")}</span></p>
                        )}
                        <p>
                          {before}<a href={p.source.url} rel="noopener" class="rk-link rk-link--inline">{p.source.name}</a>{between}{p.source.date}{after}
                          {p.source.unofficial && <> {t("ranking.noOficial")}</>}
                        </p>
                        {p.note && <p>{p.note}</p>}
                        {p.deal && <a href={`#${p.deal.id}`} class="rk-link rk-terms-ref">{t("ficha.precio.verCondiciones")}</a>}
                      </div>
                    </Cifra>
                  </dl>
                </li>
              );
            })
          }
        </ol>
      </section>

      <div class="band-white">
        <div class="wrap rk-after">
          <p class="rk-left-out">{leftOut.text}</p>
          {
            deals.length > 0 && (
              <section aria-labelledby="condiciones" class="rk-terms">
                <h2 id="condiciones" class="rk-h2 wide">{t("ficha.condiciones.titulo")}</h2>
                <ul class="mt-6 flex flex-col gap-6">
                  {deals.map((deal) => <RankingTerms deal={deal} />)}
                </ul>
              </section>
            )
          }
        </div>
      </div>
    </main>
  </body>
</html>

<style is:global>
  .rk-head {
    padding-block: 0.75rem 2rem;
  }

  .rk-crumbs {
    align-items: center;
    color: var(--color-ink-600);
    display: flex;
    flex-wrap: wrap;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    margin-top: 0.5rem;
    overflow-wrap: anywhere;
  }

  .rk-crumbs li:first-child::after {
    content: "›" / "";
    margin-inline: 0.5rem;
  }

  .rk-link {
    align-items: center;
    color: var(--color-brand-600);
    display: inline-flex;
    min-height: var(--spacing-touch);
    text-decoration: underline;
  }

  .rk-link:hover {
    color: var(--color-brand-800);
  }

  .rk-link--inline {
    display: inline;
    min-height: 0;
    padding-block: 0.25rem;
  }

  /* Ranking titles are long sentences: one step below the catalog's --text-display (spec, "Cabecera"). */
  .rk-title {
    font-size: var(--text-screen);
    line-height: 1;
    margin-top: 0.75rem;
    max-width: 18ch;
  }

  .rk-intro,
  .rk-order,
  .rk-scope {
    max-width: var(--container-prose);
  }

  .rk-intro {
    color: var(--color-ink-600);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    margin-top: 1rem;
  }

  .rk-order {
    font-size: var(--text-body);
    font-weight: 700;
    line-height: var(--text-body--line-height);
    margin-top: 0.75rem;
  }

  .rk-scope {
    color: var(--color-ink-600);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    margin-top: 0.5rem;
  }

  .rk-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    padding-block: 1rem;
  }

  .rk-select {
    align-items: center;
    display: flex;
    flex: 1 1 100%;
    gap: 0.75rem;
    font-size: var(--text-small);
    font-weight: 600;
  }

  .rk-select span {
    min-width: 5.5rem;
  }

  .rk-select select {
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    color: var(--color-ink-900);
    flex: 1;
    font: inherit;
    min-height: var(--spacing-touch);
    min-width: 0;
    padding-inline: 1rem;
  }

  @media (min-width: 768px) {
    .rk-select {
      flex: 0 1 auto;
    }

    .rk-select span {
      min-width: 0;
    }

    .rk-select select {
      min-width: 14rem;
    }
  }

  .rk-list-head {
    align-items: baseline;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    padding-top: 2rem;
  }

  .rk-h2 {
    font-size: var(--text-block);
  }

  .rk-summary {
    color: var(--color-ink-600);
    font-size: var(--text-body);
  }

  .rk-list {
    list-style: none;
    padding-bottom: 1.5rem;
  }

  /* One place = one row of the screen. Same size and colour for every place (RF-2, CA-2). */
  .rk-place {
    border-top: 1px solid var(--color-line-soft);
    column-gap: 0.75rem;
    display: grid;
    grid-template-columns: var(--width-rank-number) minmax(0, 1fr);
    overflow-wrap: anywhere;
    padding-block: 1.5rem;
  }

  .rk-place:first-child {
    margin-top: 1.25rem;
  }

  .rk-h3 {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
  }

  .rk-number {
    color: var(--color-ink-600);
    display: flex;
    flex-direction: column;
  }

  .rk-number__value {
    font-size: var(--text-rank-number);
    font-stretch: var(--font-stretch-narrow);
    font-variant-numeric: lining-nums tabular-nums;
    font-weight: 700;
    line-height: 0.82;
  }

  .rk-tie {
    font-size: var(--text-small);
    font-weight: 400;
    line-height: var(--text-small--line-height);
    margin-top: 0.375rem;
  }

  /* The underline goes on each word, never on the spaces between the inline-block words. */
  .rk-name {
    color: var(--color-ink-900);
    text-decoration: none;
  }

  .rk-brand,
  .rk-name .word {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .rk-brand {
    width: fit-content;
  }

  .rk-name:hover {
    color: var(--color-brand-800);
  }

  .rk-brand {
    display: block;
    font-size: var(--text-body);
    font-weight: 600;
    line-height: var(--text-body--line-height);
  }

  .rk-model {
    display: block;
    font-size: var(--text-version);
    margin-top: 0.25rem;
  }

  .rk-meta,
  .rk-figure {
    grid-column: 2;
  }

  .rk-version {
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    margin-top: 0.5rem;
  }

  .rk-segment {
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
  }

  .rk-segment.is-missing {
    color: var(--color-ink-600);
  }

  .rk-figure {
    border-top: 1px solid var(--color-line-soft);
    margin-top: 1rem;
    padding-top: 0.875rem;
  }

  .rk-detail {
    color: var(--color-ink-600);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    align-items: flex-start;
  }

  .rk-detail .rk-link {
    color: var(--color-brand-600);
  }

  .rk-after {
    padding-block: 2rem 3rem;
  }

  .rk-left-out {
    color: var(--color-ink-600);
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    max-width: var(--container-prose);
  }

  .rk-terms {
    margin-top: 2.5rem;
  }

  @media (min-width: 1024px) {
    .rk-head {
      padding-bottom: 3rem;
    }

    /* Desktop: number | name, version, segment | figure. The figure column is fixed, so all numbers line up. */
    .rk-place {
      column-gap: 2rem;
      grid-template-columns: var(--width-rank-number) minmax(0, 1fr) var(--width-rank-figure);
      grid-template-rows: auto 1fr;
      padding-block: 1.75rem;
    }

    .rk-h3 {
      grid-column: 1 / 3;
      grid-row: 1;
    }

    .rk-meta {
      align-self: start;
      grid-column: 2;
      grid-row: 2;
    }

    .rk-figure {
      border-top: 0;
      grid-column: 3;
      grid-row: 1 / span 2;
      margin-top: 0;
      padding-top: 0;
    }
  }

  :root {
    --width-rank-number: 3rem;
    --width-rank-figure: 22rem;
    --text-rank-number: clamp(2.75rem, 4.4vw, 4rem);
  }

  @media (min-width: 1024px) {
    :root {
      --width-rank-number: 6rem;
    }
  }
</style>
