---
// Segment silhouette in the chosen direction (docs/design/siluetas-segmento.md, «En la dirección visual»).
// Top: the model page's first screen without a photo (dark band). Below: three catalogue screens without a
// photo (light band), odd / even / odd, so both sides of the wide layout show. Real data, hard cases first:
// the tallest silhouette with the longest name, a long name, a low one, and no segment (generic) nor price.
import "../src/styles/global.css";
import "./pantalla.css";
import SegmentSilhouette from "../src/components/SegmentSilhouette.astro";
import Cifra from "./a/Cifra.astro";
import { cardView } from "../src/lib/card.ts";
import { loadModels, type Sourced } from "../src/lib/data.ts";
import { formatDecimal, formatEur, formatNumber } from "../src/lib/format.ts";
import { t } from "../src/lib/i18n.ts";

const { models } = loadModels();
const byFile = (file: string) => models.find((m) => m.file === file)!;

const hero = byFile("renault/master-furgon-e-tech-electrico.yaml");
const heroCard = cardView(hero);
const best = (list: (Sourced<number> | null | undefined)[]) =>
  list.reduce<Sourced<number> | null>((top, d) => (d && (!top || d.value > top.value) ? d : top), null);
const power = hero.specs.power_max_kw ?? best(hero.versions.map((v) => v.power_kw));
const battery = best(hero.versions.map((v) => v.battery_kwh));
const heroFigures = [
  { label: heroCard.labels.price, text: hero.price_from ? formatEur(hero.price_from.value) : null },
  { label: heroCard.labels.range, text: hero.max_range_km ? t("ficha.unidad.km", { n: formatNumber(hero.max_range_km.value) }) : null },
  { label: t("ficha.campo.potencia"), text: power ? t("ficha.unidad.kw", { n: formatDecimal(power.value) }) : null },
  { label: t("ficha.campo.bateria"), text: battery ? t("ficha.unidad.kwh", { n: formatDecimal(battery.value) }) : null },
];

const CASES = [
  "renault/grand-kangoo-e-tech-electrico.yaml",
  "mercedes-benz/cla-shooting-brake.yaml",
  "smart/hashtag-2.yaml",
];
const screens = CASES.map((file) => {
  const m = byFile(file);
  return {
    card: cardView(m),
    price: m.price_from ? formatEur(m.price_from.value) : null,
    range: m.max_range_km ? t("ficha.unidad.km", { n: formatNumber(m.max_range_km.value) }) : null,
  };
});
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("ficha.titulo", { marca: heroCard.brand, modelo: heroCard.model })}</title>
  </head>
  <body>
    <main>
      <section class="hero band-dark">
        <div class="hero-screen">
          <div class="wrap hero-top">
            <a href="/" class="wordmark">{t("sitio.nombre")}</a>
            <nav aria-label={t("ficha.ruta.nombre")} class="crumbs">
              <ol>
                <li><a href="/coches">{t("ficha.ruta.coches")}</a></li>
                <li><a href="/marcas/renault/">{heroCard.brand}</a></li>
                <li aria-current="page">{heroCard.model}</li>
              </ol>
            </nav>
          </div>
          <div class="wrap hero-text">
            <h1 class="hero-name wide">
              <span class="hero-brand">{heroCard.brand}</span>
              <span class="hero-model">{heroCard.model.split(" ").map((w) => <><span class="word">{w}</span>{" "}</>)}</span>
            </h1>
            <p class="hero-segment">{heroCard.hasSegment && <>{t("ficha.segmento.rotulo")}: </>}{heroCard.segmentLabel}</p>
          </div>
          {/* After the text in the DOM, as in web/src; placed above it on mobile with `order`. */}
          <div class="sil sil--hero" data-slot="silhouette">
            <SegmentSilhouette segment={heroCard.segment} large />
          </div>
        </div>
        <section aria-label="Cifras clave" class="wrap figures">
          <dl class="figures-grid">
            {heroFigures.map((f) => <Cifra size="xl" class="figure" label={f.label} text={f.text} />)}
          </dl>
        </section>
      </section>

      <ul class="screens">
        {
          screens.map(({ card, price, range }) => (
            <li class="screen band-light">
              <div class="sil sil--card" data-slot="silhouette">
                <SegmentSilhouette segment={card.segment} large />
              </div>
              <div class="wrap screen-inner">
                <div class="screen-text">
                  <p class="screen-brand">{card.brand}</p>
                  <h2 class="screen-name wide">
                    <a href={`/marcas/${card.key}/`} class="screen-link">{card.model.split(" ").map((w) => <><span class="word">{w}</span>{" "}</>)}</a>
                  </h2>
                  <p class:list={["screen-segment", !card.hasSegment && "is-missing"]}>{card.segmentLabel}</p>
                  {card.statusLabel && (
                    <p class="screen-status">
                      <span class="inline-block rounded-full bg-soon-bg px-3 py-1 text-badge text-soon-fg">{card.statusLabel}</span>
                    </p>
                  )}
                  <dl class="screen-figures">
                    <Cifra size="l" label={card.dealLabel ? `${card.labels.price} · ${card.dealLabel}` : card.labels.price} text={price} />
                    <Cifra size="l" label={card.labels.range} text={range} />
                  </dl>
                  <p class="screen-foot">
                    {card.compare && (
                      <a href={card.compare.href} class="foot-link">
                        {card.compare.label}
                        <span class="sr-only"> {card.compare.srLabel}</span>
                      </a>
                    )}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

<style is:global>
  /* Proposed tokens (docs/design/tokens.md, «Silueta en la dirección visual»). */
  :root {
    --color-silhouette: #a3ada7; /* on surface-muted 2,03 */
    --size-silhouette-stroke: 2px;
    --size-silhouette-card: 15rem;
    --size-silhouette-card-lg: 28rem;
    --size-silhouette-hero: 18rem;
    --size-silhouette-hero-lg: 34rem;
  }
  .band-dark {
    --color-silhouette: #45525b; /* on ink-950 2,34 */
  }

  /* The silhouette: a picture in the cutout's slot, never under the text. The SVG is square (viewBox 48);
     the wheels end at y = 38, so it is pulled down 10/48 of its side to stand on the slot's bottom. */
  .sil {
    align-items: flex-end;
    color: var(--color-silhouette);
    display: flex;
    justify-content: center;
    pointer-events: none;
  }
  .sil svg {
    aspect-ratio: 1;
    flex: none;
    /* SegmentSilhouette writes width and height inline; the height must follow the width (see the spec). */
    height: auto !important;
    margin-bottom: calc(var(--size-segment-icon-lg) * -10 / 48);
    max-height: none;
    stroke-width: var(--size-silhouette-stroke);
  }
  .sil svg :is(path, circle) {
    vector-effect: non-scaling-stroke;
  }

  /* ---- Model page, first screen (dark) ---- */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
  }
  .hero-screen {
    display: flex;
    flex: 1;
    flex-direction: column;
    position: relative;
  }
  .hero-top { order: 0; padding-top: 0.5rem; position: relative; width: 100%; }
  .sil--hero {
    --size-segment-icon-lg: min(var(--size-silhouette-hero), 100%);
    flex: 1;
    margin: 1.5rem 1.25rem 0;
    min-height: var(--size-cutout-mobile);
    order: 1;
  }
  .hero-text { order: 2; padding-block: 1.5rem 0.5rem; position: relative; width: 100%; }
  .crumbs ol { display: flex; flex-wrap: wrap; font-size: var(--text-small); line-height: var(--text-small--line-height); }
  .crumbs li { align-items: center; display: flex; min-height: var(--spacing-touch); overflow-wrap: anywhere; }
  .crumbs li:not(:last-child)::after { content: "›" / ""; margin-inline: 0.5rem; }
  .crumbs a { text-decoration: underline; }
  .hero-name { display: block; font-size: var(--text-display); line-height: 0.98; }
  .hero-brand { display: block; font-size: var(--text-body); font-stretch: 100%; font-weight: 600; letter-spacing: 0; line-height: var(--text-body--line-height); margin-bottom: 0.25rem; }
  .hero-model { display: block; }
  .hero-segment { font-size: var(--text-small); line-height: var(--text-small--line-height); margin-top: 0.75rem; }
  .figures { padding-block: 1.25rem 2.5rem; width: 100%; }
  .figures-grid { display: grid; gap: 1.25rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .figure { border-top: 1px solid var(--color-line-soft); padding-top: 0.75rem; }

  /* ---- Catalogue screen without photo (light) ---- */
  .screens { display: flex; flex-direction: column; }
  .screen { overflow: hidden; position: relative; }
  .sil--card {
    --size-segment-icon-lg: min(var(--size-silhouette-card), 100%);
    height: calc(var(--size-silhouette-card) * 32 / 48); /* 10rem: the tallest car (furgoneta, y 7) fits */
    inset: 1.5rem 1.25rem auto;
    position: absolute;
  }
  .screen-inner { position: relative; width: 100%; }
  .screen-text { padding-block: 12.5rem 0.5rem; }
  .screen-brand { font-size: var(--text-body); font-weight: 600; line-height: var(--text-body--line-height); }
  .screen-name { font-size: var(--text-screen); margin-top: 0.125rem; }
  .screen-link { color: inherit; }
  .screen-link::after { content: ""; inset: 0; position: absolute; }
  .screen-segment { font-size: var(--text-small); line-height: var(--text-small--line-height); margin-top: 0.5rem; }
  .screen-segment.is-missing { color: var(--color-ink-600); }
  .screen-status { margin-top: 0.75rem; }
  .screen-figures { column-gap: 1.25rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: 1rem; }
  .screen-figures > div { border-top: 1px solid var(--color-line-soft); padding-top: 0.875rem; }
  .screen-foot { display: flex; margin-top: 0.25rem; }
  .foot-link { align-items: center; color: var(--color-brand-600); display: inline-flex; font-size: var(--text-small); font-weight: 700; min-height: var(--spacing-touch); position: relative; text-decoration: underline; z-index: 1; }

  @media (min-width: 1024px) {
    /* Model page: text on the left half, the car on the right half, standing above the key figures. */
    .hero-screen { justify-content: space-between; }
    .sil--hero {
      --size-segment-icon-lg: min(var(--size-silhouette-hero-lg), 100%);
      inset: 6.5rem 2.5rem 1rem 50%;
      margin: 0;
      min-height: 0;
      position: absolute;
    }
    .hero-text { padding-top: 7rem; }
    .hero-text > * { max-width: calc(min(50vw, 45rem) - 4rem); }
    .figures-grid { gap: 2.5rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }

    /* Catalogue: the half opposite the text, alternating like the photos. */
    .screen { min-height: 31.5rem; display: flex; flex-direction: column; justify-content: flex-end; }
    .sil--card {
      --size-segment-icon-lg: min(var(--size-silhouette-card-lg), 100%);
      height: auto;
      inset: 2.5rem 2.5rem 2.5rem 50%;
    }
    .screen:nth-child(even) .sil--card { inset: 2.5rem 50% 2.5rem 2.5rem; }
    .screen-text { max-width: 44%; padding-block: 2rem 0.75rem; }
    .screen:nth-child(even) .screen-text { margin-left: auto; }
  }
</style>
