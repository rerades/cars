---
/**
 * /coches top in the chosen direction with the "Explorar" strip and its fifth group, "Rankings"
 * (docs/design/rankings.md, "Entrada desde /coches"; paginas-catalogo.md, "Franja Explorar").
 * Real groups from exploreGroups(); no new JavaScript.
 */
import "../src/styles/global.css";
import "./pantalla.css";
import { countLabel, exploreGroups, type ExploreGroup } from "../src/lib/catalog.ts";
import { loadModels } from "../src/lib/data.ts";
import { RANKINGS } from "../src/lib/rankings.ts";
import { t, type MessageKey } from "../src/lib/i18n.ts";

const { models } = loadModels();
const rankings: ExploreGroup = {
  label: t("explorar.rankings"),
  links: RANKINGS.map((r) => ({ label: t(`explorar.ranking.${r.id}` as MessageKey), href: `${r.url}/`, current: false })),
};
const groups = [...exploreGroups(models, "/coches/"), rankings];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("pagina.coches.titulo")}</title>
  </head>
  <body>
    <header class="band-dark">
      <div class="wrap ex-head">
        <a href="/" class="wordmark">{t("sitio.nombre")}</a>
        <h1 class="ex-title wide">{t("pagina.coches.titulo")}</h1>
        <p class="ex-intro">{t("pagina.coches.entrada")}</p>
      </div>
    </header>
    <main>
      <nav class="band-white" aria-labelledby="explorar">
        <div class="wrap ex-strip">
          <h2 id="explorar" class="ex-h2 wide">{t("explorar.titulo")}</h2>
          {
            groups.map((g) => (
              <div class:list={["ex-group", g === rankings && "ex-group--rankings"]}>
                <h3 class="ex-h3">{g.label}</h3>
                <ul class="ex-links">
                  {g.links.map((l) => (
                    <li>
                      <a href={l.href} class="ex-link" aria-current={l.current ? "page" : undefined}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </nav>
      <div class="band-light">
        <div class="wrap ex-bar">
          <p class="ex-count">{countLabel(models.length)}</p>
          <p class="ex-nojs">{t("filtros.sinJs")}</p>
        </div>
      </div>
    </main>
  </body>
</html>

<style is:global>
  .ex-head {
    padding-block: 0.75rem 1.5rem;
  }

  .ex-title {
    font-size: var(--text-display);
    line-height: 0.98;
    margin-top: 0.75rem;
  }

  .ex-intro {
    color: var(--color-ink-600);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    margin-top: 1rem;
    max-width: var(--container-prose);
  }

  .ex-strip {
    padding-block: 2rem;
  }

  .ex-h2 {
    font-size: var(--text-block);
    margin-bottom: 1rem;
  }

  /* Each group: a thin rule on top, the label, then the links. Rankings is one more group, same style. */
  .ex-group {
    border-top: 1px solid var(--color-line-soft);
    padding-block: 0.75rem;
  }

  .ex-h3 {
    font-size: var(--text-small);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: var(--text-small--line-height);
    text-transform: uppercase;
  }

  .ex-links {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
  }

  .ex-link {
    align-items: center;
    color: var(--color-brand-600);
    display: inline-flex;
    font-size: var(--text-body);
    min-height: var(--spacing-touch);
    overflow-wrap: anywhere;
    text-decoration: underline;
  }

  .ex-link:hover {
    color: var(--color-brand-800);
  }

  .ex-link[aria-current="page"] {
    color: var(--color-ink-900);
    font-weight: 600;
    text-decoration: none;
  }

  .ex-bar {
    padding-block: 0.75rem;
  }

  .ex-count {
    font-size: var(--text-small);
    font-weight: 600;
  }

  .ex-nojs {
    color: var(--color-ink-600);
    font-size: var(--text-small);
  }

  @media (min-width: 768px) {
    .ex-group {
      align-items: baseline;
      column-gap: 1.5rem;
      display: grid;
      grid-template-columns: var(--width-explore-label) minmax(0, 1fr);
      padding-block: 0.25rem;
    }

    .ex-h3 {
      padding-top: 0.75rem;
    }
  }
</style>
