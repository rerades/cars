---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import "../src/styles/global.css";
import "./pantalla.css";
import SegmentSilhouette from "../src/components/SegmentSilhouette.astro";
import Cifra from "./a/Cifra.astro";
import { cardView } from "../src/lib/card.ts";
import { countLabel } from "../src/lib/catalog.ts";
import { imageRelPath, loadModels } from "../src/lib/data.ts";
import { formatEur, formatNumber } from "../src/lib/format.ts";
import { t } from "../src/lib/i18n.ts";

// Hard cases first: long name with a good photo, a street photo, no photo (nor price, nor segment), no price.
const CASES = [
  "renault/r5-e-tech-electrico.yaml",
  "hyundai/ioniq-5.yaml",
  "smart/hashtag-2.yaml",
  "kia/ev3.yaml",
];
const { models } = loadModels();
const picked = CASES.map((file) => models.find((m) => m.file === file)!);

const files = import.meta.glob<{ default: ImageMetadata }>("@images/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}", { eager: true });
const srcOf = (file?: string) => {
  const rel = file ? imageRelPath(file) : null;
  return rel ? Object.entries(files).find(([key]) => key.endsWith(`/${rel}`))?.[1].default : undefined;
};
const screens = picked.map((m) => ({
  card: cardView(m),
  src: srcOf(m.images[0]?.file),
  price: m.price_from ? formatEur(m.price_from.value) : null,
  range: m.max_range_km ? t("ficha.unidad.km", { n: formatNumber(m.max_range_km.value) }) : null,
}));
const filters = ["filtros.marca", "filtros.segmento", "filtros.precio", "filtros.autonomia", "filtros.traccion", "filtros.estado"] as const;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("pagina.coches.titulo")}</title>
  </head>
  <body>
    <header class="band-dark">
      <div class="wrap catalog-head">
        <a href="/" class="wordmark">{t("sitio.nombre")}</a>
        <h1 class="catalog-title wide">{t("pagina.coches.titulo")}</h1>
        <p class="catalog-intro">{t("pagina.coches.entrada")}</p>
      </div>
    </header>

    <main>
      <section class="band-light" aria-label={t("filtros.titulo")}>
        <div class="wrap filter-bar">
          <p class="filter-count" data-count>{countLabel(models.length)}</p>
          <div class="filter-pills filter-pills--wide">
            {filters.map((key) => <button type="button" class="pill">{t(key)}</button>)}
          </div>
          <button type="button" class="pill filter-pills--narrow">{t("filtros.abrir", { n: 0 })}</button>
          <button type="button" class="pill pill--order">{t("orden.etiqueta")}: {t("orden.novedad")}</button>
        </div>
      </section>

      <ul class="screens">
        {
          screens.map(({ card, src, price, range }) => (
            <li class:list={["screen", src ? "band-dark" : "band-light", !src && "screen--empty"]}>
              {src ? (
                <div class="photo">
                  <Image src={src} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 70vw, 100vw" />
                </div>
              ) : (
                <div class="silhouette">
                  <SegmentSilhouette segment={card.segment} large />
                </div>
              )}
              <div class="wrap screen-inner">
                <div class="screen-text">
                  <p class="screen-brand">{card.brand}</p>
                  <h2 class="screen-name wide">
                    <a href={`/marcas/${card.key}/`} class="screen-link">{card.model.split(" ").map((w) => <><span class="word">{w}</span>{" "}</>)}</a>
                  </h2>
                  <p class:list={["screen-segment", !card.hasSegment && "is-missing"]}>{card.segmentLabel}</p>
                  {card.statusLabel && (
                    <p class="screen-status">
                      <span class="inline-block rounded-full bg-soon-bg px-3 py-1 text-badge text-soon-fg" data-status={card.statusKind}>
                        {card.statusLabel}
                      </span>
                    </p>
                  )}
                  <dl class="screen-figures">
                    <Cifra size="l" label={card.dealLabel ? `${card.labels.price} · ${card.dealLabel}` : card.labels.price} text={price} />
                    <Cifra size="l" label={card.labels.range} text={range} />
                  </dl>
                  <p class="screen-foot">
                    {card.compare && (
                      <a href={card.compare.href} class="foot-link foot-link--compare">
                        {card.compare.label}
                        <span class="sr-only"> {card.compare.srLabel}</span>
                      </a>
                    )}
                    {src && card.image?.attribution && (
                      <a href={card.image.pageUrl} class="foot-link foot-link--credit">
                        {card.image.attribution}
                      </a>
                    )}
                  </p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>

<style is:global>
  .catalog-head {
    padding-block: 0.75rem 1.5rem;
  }

  .catalog-title {
    font-size: var(--text-display);
    line-height: 0.98;
    margin-top: 0.75rem;
  }

  .catalog-intro {
    color: var(--color-on-dark-muted);
    font-size: var(--text-body);
    line-height: var(--text-body--line-height);
    margin-top: 1rem;
    max-width: var(--container-prose);
  }

  .filter-bar {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 0.75rem;
  }

  .filter-count {
    flex-basis: 100%;
    font-size: var(--text-small);
    font-weight: 600;
    line-height: var(--text-small--line-height);
  }

  .filter-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-pills--wide {
    display: none;
  }

  .pill {
    align-items: center;
    background: var(--color-surface);
    border: 1px solid var(--color-line-soft);
    border-radius: var(--radius-pill);
    color: var(--color-ink-900);
    display: inline-flex;
    font-size: var(--text-small);
    font-weight: 600;
    min-height: var(--spacing-touch);
    padding-inline: 1rem;
    white-space: nowrap;
  }

  .pill::after {
    content: "⌄" / "";
    margin-left: 0.5rem;
    transform: translateY(-0.2em);
  }

  @media (min-width: 1024px) {
    .filter-bar {
      flex-wrap: nowrap;
    }

    .filter-count {
      flex-basis: auto;
      margin-right: 1rem;
      white-space: nowrap;
    }

    .filter-pills--wide {
      display: flex;
      flex-wrap: nowrap;
    }

    .filter-pills--narrow {
      display: none;
    }

    .pill--order {
      margin-left: auto;
    }
  }

  .screens {
    display: flex;
    flex-direction: column;
  }

  /* Mobile: the photo keeps the top of the screen and melts into the band; the text sits on the solid part. */
  .screen {
    --scrim: linear-gradient(to bottom, transparent 30%, rgb(var(--scrim-rgb) / 0.72) 64%, rgb(var(--scrim-rgb) / 1) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    position: relative;
  }

  .screen .photo {
    height: 19rem;
    inset: 0 0 auto;
  }

  .screen-inner {
    position: relative;
    width: 100%;
  }

  .screen-text {
    padding-block: 12.5rem 0.5rem;
  }

  .screen-brand {
    font-size: var(--text-body);
    font-weight: 600;
    line-height: var(--text-body--line-height);
  }

  .screen-name {
    font-size: var(--text-screen);
    margin-top: 0.125rem;
  }

  .screen-link {
    color: inherit;
  }

  .screen-link::after {
    content: "";
    inset: 0;
    position: absolute;
  }

  .screen-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.08em;
  }

  .screen:has(.screen-link:focus-visible) {
    outline: 3px solid var(--color-brand-600);
    outline-offset: -6px;
  }

  .screen-link:focus-visible {
    outline: none;
  }

  .screen-segment {
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    margin-top: 0.5rem;
  }

  .screen-segment.is-missing {
    color: var(--color-ink-600);
  }

  .screen-status {
    margin-top: 0.75rem;
  }

  .screen-figures {
    column-gap: 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 1rem;
  }

  .screen-figures > div {
    border-top: 1px solid var(--color-line-soft);
    padding-top: 0.875rem;
  }

  .screen-foot {
    column-gap: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .foot-link {
    align-items: center;
    display: inline-flex;
    font-size: var(--text-small);
    line-height: var(--text-small--line-height);
    min-height: var(--spacing-touch);
    position: relative;
    text-decoration: underline;
    z-index: 1;
  }

  .foot-link--compare {
    color: var(--color-brand-600);
    font-weight: 700;
  }

  .foot-link--credit {
    color: var(--color-ink-600);
    overflow-wrap: anywhere;
  }

  .foot-link:hover {
    color: var(--color-brand-800);
  }

  /* No photo: a light screen, the outline of the segment drawn large and thin as an image. */
  .silhouette {
    --size-segment-icon-lg: 24rem;
    color: var(--color-ink-950);
    display: flex;
    justify-content: center;
    left: 0;
    position: absolute;
    right: 0;
    /* -3.5rem with Manrope; Archivo's wide name sits higher, so the wheels reached the brand line. */
    top: -6.5rem;
  }

  .silhouette svg {
    stroke-width: 0.3;
  }

  @media (min-width: 1024px) {
    /* Desktop: the photo fills 70% of the band and melts into it, so the whole car shows and the name
       only overlaps its solid edge. Sides alternate. */
    .screen {
      --scrim: linear-gradient(
        to right,
        rgb(var(--scrim-rgb) / 1) 0%,
        rgb(var(--scrim-rgb) / 0.72) 22%,
        transparent 55%
      );
      min-height: 31.5rem;
    }

    .screen .photo {
      height: 100%;
      inset: 0 0 0 30%;
    }

    .screen:nth-child(even) {
      --scrim: linear-gradient(
        to left,
        rgb(var(--scrim-rgb) / 1) 0%,
        rgb(var(--scrim-rgb) / 0.72) 22%,
        transparent 55%
      );
    }

    .screen:nth-child(even) .photo {
      inset: 0 30% 0 0;
    }

    .screen:nth-child(even) .screen-text {
      margin-left: auto;
    }

    .silhouette svg {
      stroke-width: 0.22;
    }

    .screen-text {
      max-width: 44%;
      padding-block: 2rem 0.75rem;
    }

    .silhouette {
      --size-segment-icon-lg: 42rem;
      justify-content: flex-end;
      padding-right: 3rem;
      top: -7rem;
    }

    .screen:nth-child(even) .silhouette {
      justify-content: flex-start;
      padding-left: 3rem;
      padding-right: 0;
    }
  }
</style>
