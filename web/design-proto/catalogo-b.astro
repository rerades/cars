---
/**
 * Proposal B, "Cifra": catalogue (docs/design/propuesta-b.md, PRD-001). Each model is a full-width row
 * led by its two numbers; the photo goes at the end, at medium size. Filters are static.
 */
import "../src/styles/global.css";
import "./propuesta-b.css";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import SegmentSilhouette from "../src/components/SegmentSilhouette.astro";
import Cifra from "./b/Cifra.astro";
import { cardView } from "../src/lib/card.ts";
import { countLabel } from "../src/lib/catalog.ts";
import { imageRelPath, loadModels } from "../src/lib/data.ts";
import { formatEur, formatNumber } from "../src/lib/format.ts";
import { t } from "../src/lib/i18n.ts";

const { models } = loadModels();
// Hard cases first: no photo and no price with a long name; bad photo with an offer price; coming soon
// without segment; good photo.
const picked = ["mercedes-benz/cla-shooting-brake", "cupra/raval", "smart/hashtag-2", "renault/r5-e-tech-electrico"]
  .map((key) => models.find((m) => m.file === `${key}.yaml`))
  .filter((m) => m !== undefined);

const files = import.meta.glob<{ default: ImageMetadata }>("@images/**/*.{jpg,jpeg,png,JPG,JPEG,PNG}", { eager: true });
const srcOf = (file: string) => {
  const rel = imageRelPath(file);
  return rel ? Object.entries(files).find(([k]) => k.endsWith(`/${rel}`))?.[1].default : undefined;
};

const [count, ...countWords] = countLabel(models.length).split(" ");
const filters = ["filtros.marca", "filtros.segmento", "filtros.precio", "filtros.autonomia", "filtros.traccion", "filtros.estado"] as const;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("pagina.tituloDocumento", { titulo: t("pagina.coches.titulo"), sitio: t("sitio.nombre") })}</title>
    <style>
      .cabecera { display: grid; gap: 0.75rem; }
      .cabecera__titulo { padding-block: 0.5rem 0.75rem; }
      .cabecera__entrada { margin-top: 0.75rem; max-width: var(--container-prose); color: var(--color-ink-600); }
      .cabecera__cuenta { display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
      .cabecera__cuenta p { font-stretch: 125%; font-weight: 600; letter-spacing: -0.02em; line-height: 1.1; }
      .cabecera__cuenta .cifra__valor { font-size: var(--text-cifra-l); }

      .filtros { margin-top: 1rem; }
      /* One line that scrolls on mobile: the cut-off pill says there is more. Six pills wrap from lg. */
      .filtros { margin-inline: -1rem; overflow-x: auto; scrollbar-width: none; }
      .filtros ul { display: flex; gap: 0.5rem; width: max-content; padding-inline: 1rem; }
      .filtro { white-space: nowrap; }
      .filtro {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-height: var(--spacing-touch);
        padding-inline: 1rem;
        border: 1px solid var(--color-line);
        border-radius: 9999px;
        background: var(--color-surface);
        color: var(--color-ink-900);
        font-size: var(--text-small);
        font-weight: 500;
      }
      .filtro::after {
        content: "" / "";
        width: 0.4rem;
        height: 0.4rem;
        border-right: 1.5px solid currentColor;
        border-bottom: 1.5px solid currentColor;
        transform: translateY(-0.1rem) rotate(45deg);
      }

      .lista { display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1.25rem; }
      .fila { position: relative; display: grid; gap: 1rem; }
      .fila:hover { outline: 2px solid var(--color-ink-900); outline-offset: -2px; }
      .fila:has(.fila__enlace:focus-visible) { outline: 3px solid var(--color-brand-600); outline-offset: 2px; }
      .fila__marca { font-size: var(--text-small); line-height: var(--text-small--line-height); color: var(--color-ink-600); }
      .fila__enlace { color: inherit; }
      .fila__enlace:focus-visible { outline: none; }
      .fila__enlace::after { content: ""; position: absolute; inset: 0; border-radius: var(--radius-block); }
      .fila__nombre { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; }
      .fila__cifras { display: grid; gap: 1rem; }
      .fila__otros { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0 1rem; }
      .fila__segmento { font-weight: 500; }
      .fila__segmento--falta { font-weight: 400; color: var(--color-ink-600); }
      .fila__media { display: grid; gap: 0.25rem; }
      .fila .enlace { position: relative; z-index: 1; }

      /* Mobile: range across the card, then price and photo side by side, so the photo stays secondary. */
      @media (max-width: 1023px) {
        .fila { grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr); column-gap: 0.75rem; row-gap: 0.875rem; align-items: start; }
        .fila__texto, .fila__cifras, .fila__media { display: contents; }
        .fila__cabeza, .fila__cifras > :global(.cifra--xl), .fila__media > .enlace, .fila__otros { grid-column: 1 / -1; }
        .fila { --text-cifra-xl: 6.5rem; }
        .fila__media > .enlace { margin-block: -0.75rem; }
      }

      @media (min-width: 1024px) {
        .cabecera { grid-template-columns: 8fr 4fr; gap: 1rem; align-items: stretch; }
        .cabecera__titulo { padding-block: 1rem 0; }
        .cabecera__cuenta { flex-direction: column; align-items: flex-start; }
        .filtros { margin: 1.5rem 0 0; overflow: visible; }
        .filtros ul { width: auto; padding-inline: 0; flex-wrap: wrap; }
        .lista { gap: 1rem; margin-top: 1.5rem; }
        .fila { grid-template-columns: 8fr 4fr; column-gap: 2rem; align-items: start; }
        .fila__texto { display: grid; gap: 1.75rem; }
        .fila__cifras { grid-template-columns: auto minmax(0, 1fr); align-items: end; gap: 2.5rem; }
      }
    </style>
  </head>
  <body>
    <main class="pagina">
      <header class="cabecera">
        <div class="cabecera__titulo">
          <h1 class="nombre nombre--xl">{t("pagina.coches.titulo")}</h1>
          <p class="cabecera__entrada">{t("pagina.coches.entrada")}</p>
        </div>
        <div class="bloque bloque--volt cabecera__cuenta" role="status">
          <span class="cifra__valor">{count}</span>
          <p>{countWords.join(" ")}</p>
        </div>
      </header>

      <section class="filtros" aria-label={t("filtros.titulo")}>
        <ul>
          {filters.map((k) => <li><button type="button" class="filtro">{t(k)}</button></li>)}
        </ul>
      </section>

      <ul class="lista">
        {
          picked.map((m) => {
            const card = cardView(m);
            const src = card.image ? srcOf(card.image.file) : undefined;
            return (
              <li class="bloque fila">
                <div class="fila__texto">
                  <div class="fila__cabeza">
                    <p class="fila__marca">{card.brand}</p>
                    <div class="fila__nombre">
                      <h2 class="nombre nombre--l">
                        <a class="fila__enlace" href={`/marcas/${card.key}/`}>{card.model}</a>
                      </h2>
                      {card.statusLabel && <span class="etiqueta etiqueta--soon">{card.statusLabel}</span>}
                    </div>
                  </div>
                  <dl class="fila__cifras">
                    <Cifra
                      size="xl"
                      label={card.labels.range}
                      text={m.max_range_km ? t("ficha.unidad.km", { n: formatNumber(m.max_range_km.value) }) : null}
                    />
                    <Cifra size="m" label={card.labels.price} text={m.price_from ? formatEur(m.price_from.value) : null}>
                      {card.dealLabel && (
                        <span slot="marca" class="etiqueta etiqueta--deal" style="display: table; margin-top: 0.375rem">{card.dealLabel}</span>
                      )}
                    </Cifra>
                  </dl>
                </div>
                <div class="fila__media">
                  <div class:list={["foto", !src && "foto--vacia"]}>
                    {src ? (
                      <Image src={src} alt="" width={640} height={360} widths={[320, 640]} sizes="(min-width: 1024px) 24rem, 100vw" />
                    ) : (
                      <SegmentSilhouette segment={card.segment} large />
                    )}
                  </div>
                  {src && card.image?.attribution && (
                    <a class="enlace enlace--pie" href={card.image.pageUrl}>{card.image.attribution}</a>
                  )}
                  <div class="fila__otros">
                    <span class:list={["fila__segmento", !card.hasSegment && "fila__segmento--falta"]}>{card.segmentLabel}</span>
                    {card.compare && (
                      <a class="enlace" href={card.compare.href}>
                        {card.compare.label}<span class="sr-only"> {card.compare.srLabel}</span>
                      </a>
                    )}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ul>
    </main>
  </body>
</html>
