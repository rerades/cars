<?xml version="1.0" encoding="UTF-8"?>
<!-- Copiar a ~/Library/LaunchAgents/com.darkfactory.orchestrator.plist, ajustar RUTA y cargar:
     launchctl load ~/Library/LaunchAgents/com.darkfactory.orchestrator.plist
     Lanza el orquestador cada hora dentro de la ventana nocturna; run.py descarta
     las horas fuera de allowed_hours, así que basta con dejarlo correr. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.darkfactory.orchestrator</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/USUARIO/_DEV/cars/factory/run.py</string>
    <string>--next</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/USUARIO/_DEV/cars</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
    <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>/Users/USUARIO/_DEV/cars/ops/launchd.out.log</string>
  <key>StandardErrorPath</key><string>/Users/USUARIO/_DEV/cars/ops/launchd.err.log</string>
</dict>
</plist>
